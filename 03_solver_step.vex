// ============================================================
// STEP 3: solver_step.vex — LANE-BASED ROUTE SWITCHING
// ============================================================
// Run Over: Points | Inside Solver
// INPUT 0: prev_frame | INPUT 1: Object Merge (route_curves)
//
// At each intersection boundary:
//   Outer lane → picks: road(outer), straight(outer), right_turn
//   Inner lane → picks: road(inner), straight(inner), left_turn
//
// Parameters:
//   max_speed           (float) = 15
//   acceleration        (float) = 8
//   deceleration        (float) = 25
//   look_ahead_dist     (float) = 25
//   cross_detect_dist   (float) = 30
//   min_safe_dist       (float) = 10
//   cross_safe_time     (float) = 1.5
//   search_count        (int)   = 150
//   vehicle_offset      (float) = 0.5
//   route_match_dist    (float) = 2.0
//   straight_bias       (float) = 0.65
// ============================================================

if(s@curve_type != "vehicle") return;

float max_speed  = ch("max_speed");
float accel      = ch("acceleration");
float decel      = ch("deceleration");
float look_dist  = ch("look_ahead_dist");
float cross_dist = ch("cross_detect_dist");
float safe_dist  = ch("min_safe_dist");
float cross_time = ch("cross_safe_time");
int   max_search = chi("search_count");
float y_off      = ch("vehicle_offset");
float match_dist = ch("route_match_dist");
float str_bias   = ch("straight_bias");

float dt = @TimeInc;
if(dt <= 0) dt = 1.0 / 24.0;

float u         = f@u_param;
float cur_speed = f@speed;
vector my_pos   = @P;
vector my_dir   = @N;
int   my_vid    = i@vehicle_id;
int   my_route  = i@route_id;
float prim_len  = f@prim_length;
string my_lane  = s@lane_type;

int num_routes = nprimitives(1);
if(num_routes == 0 || my_route < 0 || my_route >= num_routes) {
    f@brake = 1.0;
    return;
}

float target = max_speed;


// =======================================================
// PHASE 1: Same-lane following
// =======================================================
vector fwd_center = my_pos + my_dir * (look_dist * 0.4);
int fwd_nearby[] = pcfind(0, "P", fwd_center, look_dist, max_search);
float closest_follow = 1e9;

foreach(int nb; fwd_nearby) {
    if(point(0, "curve_type", nb) != "vehicle") continue;
    if(point(0, "vehicle_id", nb) == my_vid) continue;
    vector nb_pos = point(0, "P", nb);
    vector nb_dir = point(0, "N", nb);
    if(dot(my_dir, nb_dir) < 0.4) continue;
    vector to_nb = nb_pos - my_pos;
    float fwd = dot(to_nb, my_dir);
    if(fwd < 0.3) continue;
    float lat = length(to_nb - my_dir * fwd);
    if(lat > safe_dist * 0.6) continue;
    if(fwd < closest_follow) closest_follow = fwd;
}
if(closest_follow < 1e8) {
    float room = closest_follow - safe_dist;
    if(room <= 0.5) target = 0.0;
    else if(room < look_dist * 0.7)
        target = min(target, max_speed * smooth(0, 1, clamp(room / (look_dist * 0.7), 0, 1)));
}


// =======================================================
// PHASE 2: Cross-traffic
// =======================================================
int cross_nearby[] = pcfind(0, "P", my_pos, cross_dist, max_search);
foreach(int nb; cross_nearby) {
    if(point(0, "curve_type", nb) != "vehicle") continue;
    if(point(0, "vehicle_id", nb) == my_vid) continue;
    int nb_route = point(0, "route_id", nb);
    if(nb_route == my_route) continue;
    vector nb_pos = point(0, "P", nb);
    vector nb_dir = point(0, "N", nb);
    if(dot(my_dir, nb_dir) < -0.7) continue;
    int xor_val = my_route ^ nb_route;
    int i_yield = (xor_val & 1) ? (my_route > nb_route) : (my_route < nb_route);
    if(!i_yield) continue;
    vector to_nb = nb_pos - my_pos;
    float dist = length(to_nb);
    float my_proj = dot(to_nb, my_dir);
    float nb_proj = dot(-to_nb, nb_dir);
    if(my_proj < -safe_dist || nb_proj < -safe_dist * 2) continue;
    float my_t = max(my_proj, 0) / max(cur_speed, 0.01);
    float nb_t = max(nb_proj, 0) / max(point(0, "speed", nb), 0.01);
    vector my_cross = my_pos + my_dir * max(my_proj, 0);
    vector nb_cross = nb_pos + nb_dir * max(nb_proj, 0);
    float gap = length(my_cross - nb_cross);
    int is_threat = 0;
    if(dist < safe_dist * 1.5 && dot(normalize(to_nb), my_dir) > -0.3) is_threat = 1;
    else if(gap < safe_dist * 2.5 && abs(my_t - nb_t) < cross_time) is_threat = 1;
    else if(gap < safe_dist * 2 && my_proj > 0 && nb_proj > 0 && abs(my_t - nb_t) < cross_time * 1.5) is_threat = 1;
    if(!is_threat) continue;
    float stop_room = max(my_proj - safe_dist, 0);
    if(stop_room <= 0.5) target = 0;
    else target = min(target, max_speed * smooth(0, 1, clamp(stop_room / cross_dist, 0, 1)));
}


// =======================================================
// PHASE 3: Speed adjustment
// =======================================================
if(cur_speed < target) cur_speed = min(cur_speed + accel * dt, target);
else if(cur_speed > target) cur_speed = max(cur_speed - decel * dt, target);
cur_speed = clamp(cur_speed, 0, max_speed);


// =======================================================
// PHASE 4: Advance
// =======================================================
if(prim_len > 0.01 && cur_speed > 0.001) {
    u += cur_speed * dt / prim_len;
}


// =======================================================
// PHASE 5: LANE-BASED ROUTE SWITCHING
//
// Triggers at u >= 1.0 (vehicle reached the true endpoint).
// Carries excess distance into the new segment so
// there's zero position snap.
//
// FIX v2: Probability-based straight/turn selection.
//   1. Collect candidates, split into straight[] and turn[].
//   2. Roll a per-vehicle random number each frame.
//   3. If roll < straight_bias → pick from straight pool.
//      Otherwise           → pick from turn pool.
//   4. Within the chosen pool, pick by forward alignment
//      + small jitter (handles the rare >1 candidate case).
//   5. If the chosen pool is empty, fall back to the other.
//
//   straight_bias = 0.65  →  ~65% straight, ~35% turn
//   Fully tunable. 0 = always turn, 1 = always straight.
// =======================================================
if(u >= 1.0) {
    float excess_dist = (u - 1.0) * prim_len;

    vector end_pos = primuv(1, "P", my_route, set(0.999, 0, 0));

    // Collect all compatible candidates
    int candidates[];
    for(int r = 0; r < num_routes; r++) {
        if(r == my_route) continue;
        vector r_start = primuv(1, "P", r, set(0.001, 0, 0));
        if(length(r_start - end_pos) > match_dist) continue;

        string r_lane = prim(1, "lane_type", r);
        if(r_lane != my_lane) continue;

        append(candidates, r);
    }

    if(len(candidates) > 0) {

        // ---- Split into straight vs turn pools ----
        int straight_pool[];
        int turn_pool[];
        for(int ci = 0; ci < len(candidates); ci++) {
            int r = candidates[ci];
            string stype = prim(1, "segment_type", r);
            if(stype == "right_turn" || stype == "left_turn")
                append(turn_pool, r);
            else
                append(straight_pool, r);
        }

        // ---- Decide: straight or turn? ----
        float roll = random(my_vid * 0.73 + @Frame * 0.19);
        int use_straight = 1;

        if(len(straight_pool) > 0 && len(turn_pool) > 0) {
            // Both options exist — use probability
            use_straight = (roll < str_bias) ? 1 : 0;
        } else if(len(straight_pool) == 0) {
            use_straight = 0;   // only turns available
        }
        // else: only straight available, use_straight stays 1

        int pool[];
        if(use_straight && len(straight_pool) > 0)
            pool = straight_pool;
        else if(len(turn_pool) > 0)
            pool = turn_pool;
        else
            pool = candidates;  // fallback

        // ---- Pick best within the chosen pool ----
        int best = pool[0];
        float best_score = -1e9;
        for(int ci = 0; ci < len(pool); ci++) {
            int r = pool[ci];
            vector rf = primuv(1, "P", r, set(0.02, 0, 0));
            vector rb = primuv(1, "P", r, set(0.005, 0, 0));
            vector rdir = normalize(rf - rb);

            float score = dot(my_dir, rdir);
            score += random(my_vid * 0.37 + @Frame * 0.13 + ci * 0.71) * 0.15;

            if(score > best_score) {
                best_score = score;
                best = r;
            }
        }

        // ---- Switch to new segment ----
        float new_prim_len = primintrinsic(1, "measuredperimeter", best);

        float new_u = excess_dist / max(new_prim_len, 0.01);
        new_u = clamp(new_u, 0.001, 0.98);

        i@route_id = best;
        f@u_param = new_u;
        f@prim_length = new_prim_len;
        s@lane_type = prim(1, "lane_type", best);

        vector new_pos = primuv(1, "P", best, set(new_u, 0, 0));
        new_pos.y += y_off;
        @P = new_pos;

        float tang_u = new_u;
        vector nf = primuv(1, "P", best, set(min(tang_u + 0.04, 0.999), 0, 0));
        vector nb = primuv(1, "P", best, set(max(tang_u - 0.04, 0.001), 0, 0));
        @N = normalize(nf - nb);

        f@speed = cur_speed;
        f@brake = 1.0 - clamp(cur_speed / max(max_speed, 0.01), 0, 1);
        return;
    } else {
        // =================================================
        // NO CANDIDATES — edge/corner of grid.
        // The vehicle has nowhere to go (traveling outward
        // off the grid boundary).  Respawn it on a random
        // interior road segment to simulate leaving the
        // area and a new vehicle entering elsewhere.
        // =================================================
        int respawn_pool[];
        for(int r = 0; r < num_routes; r++) {
            string stype = prim(1, "segment_type", r);
            if(stype != "road") continue;
            string rlane = prim(1, "lane_type", r);
            if(rlane != my_lane) continue;
            float rlen = primintrinsic(1, "measuredperimeter", r);
            if(rlen < 15) continue;    // skip short stubs
            append(respawn_pool, r);
        }

        if(len(respawn_pool) > 0) {
            // Pick a random road segment
            int idx = int(random(my_vid * 0.53 + @Frame * 0.29)
                          * float(len(respawn_pool)));
            idx = clamp(idx, 0, len(respawn_pool) - 1);
            int new_route = respawn_pool[idx];

            float new_prim_len = primintrinsic(1, "measuredperimeter", new_route);

            // Spawn near the start of the segment so it
            // has a full road ahead (avoids instant re-switch)
            float new_u = fit01(
                random(my_vid * 0.17 + @Frame * 0.83),
                0.05, 0.30);

            i@route_id    = new_route;
            f@u_param     = new_u;
            f@prim_length = new_prim_len;
            s@lane_type   = prim(1, "lane_type", new_route);

            vector new_pos = primuv(1, "P", new_route, set(new_u, 0, 0));
            new_pos.y += y_off;
            @P = new_pos;

            vector nf = primuv(1, "P", new_route,
                               set(min(new_u + 0.04, 0.999), 0, 0));
            vector nb = primuv(1, "P", new_route,
                               set(max(new_u - 0.04, 0.001), 0, 0));
            @N = normalize(nf - nb);

            f@speed        = max_speed * 0.5;  // enter at half speed
            f@target_speed = max_speed;
            f@brake        = 0;
            return;
        }

        // Absolute fallback (shouldn't happen)
        u = u - 1.0;
        u = clamp(u, 0.001, 0.999);
    }
}

u = clamp(u, 0.001, 0.999);


// =======================================================
// PHASE 6: Update position
// =======================================================
vector new_pos = primuv(1, "P", my_route, set(u, 0, 0));
new_pos.y += y_off;

// Tangent: use wider eps for smooth direction on curves
// Small eps causes direction snapping at each vertex
float tang_eps = 0.04;
vector p_fwd = primuv(1, "P", my_route, set(min(u + tang_eps, 0.999), 0, 0));
vector p_bck = primuv(1, "P", my_route, set(max(u - tang_eps, 0.001), 0, 0));
@P = new_pos;
@N = normalize(p_fwd - p_bck);
f@u_param = u;
f@speed = cur_speed;
f@target_speed = target;
f@brake = 1.0 - clamp(cur_speed / max(max_speed, 0.01), 0, 1);
