// ============================================================
// 08_bbox_collision.vex — Predictive Bounding Box Collision
// ============================================================
// WHERE:  AttribWrangle "bbox_collision" INSIDE the Solver SOP
//
//         WIRING ORDER:
//         prev_frame → solver_step → signal_brake → bbox_collision → Output
//
// RUN OVER: Points
//
// WHAT CHANGED (v2.5 — fixes straight-passing false brakes):
//
//   v2.4 fixed intersection false brakes for cross-traffic stopped
//   at red lights.  However, vehicles going OPPOSITE directions
//   through the same intersection on their own lanes were still
//   falsely braking for each other.
//
//   Root cause: the padded bounding boxes (half_wid + padding = 2.0
//   per car, total 4.0) are WIDER than the inner-lane separation
//   (3.5 units), so the OBB test reports "overlap" even though the
//   actual car bodies (1.0 + 1.0 = 2.0) have 1.5 units clearance.
//
//   v2.5 adds a STRAIGHT-PASSING CLEARANCE CHECK:
//   When two vehicles are going in different directions (opposite
//   or perpendicular), the code computes the lateral distance
//   between their travel paths using ACTUAL car widths (no padding).
//   If the real car bodies have clearance → skip, they'll pass
//   each other safely.
//
//   The padding is for SAME-DIRECTION following distance safety
//   (braking cushion behind the car ahead).  It should NOT inflate
//   lateral clearance checks for vehicles on separate paths.
//
// PARAMETERS (spare parms on this wrangle):
//   bbox_half_length      (float) = 2.0
//   bbox_half_width       (float) = 1.0
//   bbox_padding          (float) = 1.0
//   search_radius         (float) = 35.0
//   max_neighbors         (int)   = 50
//   brake_force           (float) = 25.0
//   look_ahead_time       (float) = 2.0
//   emergency_gap         (float) = 0.5
//   stopped_speed_thresh  (float) = 0.5
//   intersection_radius   (float) = 25.0
//   grid_size             (float) = 348
//   grid_divisions        (int)   = 4
// ============================================================

// ---------- parameters ----------
float half_len   = ch("bbox_half_length");      // 2.0
float half_wid   = ch("bbox_half_width");       // 1.0
float pad        = ch("bbox_padding");          // 1.0
float srch_rad   = ch("search_radius");         // 35.0
int   max_nb     = chi("max_neighbors");        // 50
float brk_force  = ch("brake_force");           // 25.0
float look_time  = ch("look_ahead_time");       // 2.0
float emer_gap   = ch("emergency_gap");         // 0.5
float stop_thresh = ch("stopped_speed_thresh"); // 0.5
float isect_rad  = ch("intersection_radius");   // 25.0
float grid_size  = ch("grid_size");             // 348
int   grid_div   = chi("grid_divisions");       // 4

float dt = @TimeInc;
if (dt < 1e-6) return;

// ---------- local axes (ground plane) ----------
vector fwd = normalize(set(@N.x, 0, @N.z));
if (length(fwd) < 0.01) return;
vector rgt = set(-fwd.z, 0, fwd.x);

// my velocity (2D)
vector my_vel = fwd * f@speed;

// padded half-extents (used for same-direction following)
float hl = half_len + pad;
float hw = half_wid + pad;

// ============================================================
// OBB-OBB gap function (Separating Axis Theorem, 2D)
// ============================================================
function float obb_gap(
    vector sep;
    vector a_fwd; vector a_rgt; float a_hl; float a_hw;
    vector b_fwd; vector b_rgt; float b_hl; float b_hw)
{
    float mg = -1e9;

    float p1 = abs(dot(sep, a_fwd));
    float e1 = a_hl + abs(dot(b_fwd, a_fwd)) * b_hl
                     + abs(dot(b_rgt, a_fwd)) * b_hw;
    mg = max(mg, p1 - e1);

    float p2 = abs(dot(sep, a_rgt));
    float e2 = a_hw + abs(dot(b_fwd, a_rgt)) * b_hl
                     + abs(dot(b_rgt, a_rgt)) * b_hw;
    mg = max(mg, p2 - e2);

    float p3 = abs(dot(sep, b_fwd));
    float e3 = abs(dot(a_fwd, b_fwd)) * a_hl
             + abs(dot(a_rgt, b_fwd)) * a_hw + b_hl;
    mg = max(mg, p3 - e3);

    float p4 = abs(dot(sep, b_rgt));
    float e4 = abs(dot(a_fwd, b_rgt)) * a_hl
             + abs(dot(a_rgt, b_rgt)) * a_hw + b_hw;
    mg = max(mg, p4 - e4);

    return mg;
}

// ---------- intersection proximity (grid snap) ----------
float cell      = grid_size / float(max(1, grid_div));
float half_grid = grid_size / 2.0;
float near_ix   = rint((@P.x + half_grid) / cell) * cell - half_grid;
float near_iz   = rint((@P.z + half_grid) / cell) * cell - half_grid;
int   near_isect = (length(set(@P.x - near_ix, 0, @P.z - near_iz))
                    < isect_rad) ? 1 : 0;

// ---------- neighbour search ----------
int neighbors[] = pcfind(0, "P", @P, srch_rad, max_nb);

float worst_urg = 0;
int   do_brake  = 0;

foreach (int nb; neighbors)
{
    if (nb == @ptnum) continue;

    string nb_curve = point(0, "curve_type", nb);
    if (nb_curve != "vehicle") continue;

    vector nb_pos   = point(0, "P",     nb);
    vector nb_N     = point(0, "N",     nb);
    float  nb_speed = point(0, "speed", nb);
    string nb_lane  = point(0, "lane_type", nb);

    // neighbour direction
    vector nb_fwd_chk = normalize(set(nb_N.x, 0, nb_N.z));
    if (length(nb_fwd_chk) < 0.01) continue;
    float dir_dot = dot(fwd, nb_fwd_chk);

    // separation (2D)
    vector sep = set(nb_pos.x - @P.x, 0, nb_pos.z - @P.z);

    // ========================================================
    // LANE + DIRECTION FILTERING
    // ========================================================

    if (s@lane_type != nb_lane)
    {
        // ---- DIFFERENT lane type ----
        if (!near_isect) continue;

        // Signal check (v2.4)
        int nb_signal_stop = point(0, "signal_stop", nb);
        if (nb_signal_stop == 1) continue;
        if (nb_speed < stop_thresh) continue;

        // Only crossing paths (> ~45°)
        if (abs(dir_dot) > 0.7) continue;

        // STRAIGHT-PASSING CLEARANCE (v2.5)
        // Even with different lane types, if the lateral distance
        // between our travel lines exceeds actual car widths,
        // straight-through traffic won't physically collide.
        float lat_dist = abs(dot(sep, rgt));
        if (lat_dist > half_wid * 2.0) continue;
    }
    else
    {
        // ---- SAME lane type ----

        // .....................................................
        // CASE A: OPPOSITE direction (dir_dot < -0.3)
        //   Two vehicles going opposite directions on offset
        //   parallel lanes (e.g., both "inner" on the same road,
        //   one going east, one going west).
        // .....................................................
        if (dir_dot < -0.3)
        {
            // Signal check
            int nb_sig = point(0, "signal_stop", nb);
            if (nb_sig == 1) continue;
            if (nb_speed < stop_thresh) continue;

            // STRAIGHT-PASSING CLEARANCE (v2.5 — the key fix)
            //
            // Lateral distance between our travel paths.
            // Uses ACTUAL car half-widths, NOT padded.
            // Padding is for longitudinal following cushion,
            // not for lateral passing clearance.
            //
            // Inner-lane example:
            //   lat_dist = 3.5 (lane_spacing)
            //   combined body = 1.0 + 1.0 = 2.0
            //   clearance = 1.5 > 0 → PASS safely → skip
            //
            float lat_dist = abs(dot(sep, rgt));
            if (lat_dist > half_wid * 2.0) continue;
        }

        // .....................................................
        // CASE B: PERPENDICULAR at intersection (|dir_dot| < 0.5)
        //   Same lane type but on crossing roads (e.g., both
        //   "outer" — one going east, one going north).
        //   Their paths physically cross at one point.
        // .....................................................
        else if (near_isect && abs(dir_dot) < 0.5)
        {
            // Signal check — traffic lights prevent simultaneous
            // crossing from perpendicular directions
            int nb_sig = point(0, "signal_stop", nb);
            if (nb_sig == 1) continue;
            if (nb_speed < stop_thresh) continue;

            // STRAIGHT-PASSING CLEARANCE (v2.5)
            //
            // For perpendicular paths, check lateral clearance
            // from BOTH perspectives.  If either vehicle's path
            // line is far enough from the other vehicle's lane
            // position, their bodies won't overlap even if they
            // happen to be at the crossing area simultaneously.
            //
            // Distance from neighbour to my travel line:
            float my_lat = abs(dot(sep, rgt));
            // Distance from me to neighbour's travel line:
            vector nb_rgt_chk = set(-nb_fwd_chk.z, 0, nb_fwd_chk.x);
            float nb_lat = abs(dot(-sep, nb_rgt_chk));

            // If BOTH lateral distances exceed actual body widths,
            // the crossing zone has enough clearance on both axes.
            float body_width = half_wid * 2.0;
            if (my_lat > body_width && nb_lat > body_width) continue;
        }

        // .....................................................
        // CASE C: SAME direction (dir_dot > 0.3)
        //   Following / side-by-side traffic.
        //   No filtering — full TCA + OBB evaluation.
        //   (This is the normal "don't rear-end the car ahead")
        // .....................................................
    }

    // ========================================================
    // From here on, only vehicles that passed ALL filters above
    // reach the collision checks.  These are genuine threats:
    //   - Same-direction vehicles ahead (following distance)
    //   - Vehicles with insufficient lateral clearance
    //   - Moving cross-traffic during phase transitions
    // ========================================================

    // neighbour axes
    vector nb_fwd = nb_fwd_chk;
    vector nb_rgt = set(-nb_fwd.z, 0, nb_fwd.x);

    // neighbour velocity & half-extents
    vector nb_vel = nb_fwd * nb_speed;
    float  nb_hl  = half_len + pad;
    float  nb_hw  = half_wid + pad;

    // relative velocity
    vector rel_vel = nb_vel - my_vel;

    // closing speed
    float sep_len = length(sep);
    float closing = 0;
    if (sep_len > 0.01)
        closing = -dot(rel_vel, sep / sep_len);

    // ====================================================
    // PHASE 1 — EMERGENCY (current overlap + converging)
    // ====================================================
    if (closing > 0.1)
    {
        float gap_now = obb_gap(sep,
                                fwd, rgt, hl, hw,
                                nb_fwd, nb_rgt, nb_hl, nb_hw);

        if (gap_now < emer_gap)
        {
            float urg = fit(gap_now, -hl, emer_gap, 1.0, 0.85);
            urg = clamp(urg, 0, 1);
            if (urg > worst_urg)
            {
                worst_urg = urg;
                do_brake  = 1;
            }
            continue;
        }
    }

    // ====================================================
    // PHASE 2 — PREDICTIVE (TCA + future OBB)
    // ====================================================
    float vv = dot(rel_vel, rel_vel);
    if (vv < 0.001) continue;

    float tca = -dot(sep, rel_vel) / vv;

    if (tca <= 0) continue;         // diverging → safe
    tca = min(tca, look_time);

    // predicted future positions
    vector my_fut  = set(@P.x,     0, @P.z)     + set(my_vel.x, 0, my_vel.z) * tca;
    vector nb_fut  = set(nb_pos.x, 0, nb_pos.z) + set(nb_vel.x, 0, nb_vel.z) * tca;
    vector fut_sep = nb_fut - my_fut;

    // skip if predicted to be behind us
    if (dot(fut_sep, fwd) < -half_len) continue;

    // OBB test at predicted positions
    float gap_fut = obb_gap(fut_sep,
                            fwd, rgt, hl, hw,
                            nb_fwd, nb_rgt, nb_hl, nb_hw);

    if (gap_fut < 0)
    {
        float urg = fit(tca, 0, look_time, 0.9, 0.1);
        urg = clamp(urg, 0, 1);

        if (urg > worst_urg)
        {
            worst_urg = urg;
            do_brake  = 1;
        }
    }
}

// ---------- apply braking ----------
if (do_brake)
{
    float new_speed = f@speed - brk_force * worst_urg * dt;
    f@speed = max(new_speed, 0);
    f@brake = max(f@brake, worst_urg);

    if (worst_urg > 0.95)
    {
        f@speed = 0;
        f@brake = 1.0;
    }

    i@bbox_stopped = 1;
}
else
{
    i@bbox_stopped = 0;
}
