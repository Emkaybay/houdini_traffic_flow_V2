// ============================================================
// 08_bbox_collision.vex — ALL Collision + Spacing (v2.8)
// ============================================================
// WHERE:  AttribWrangle "bbox_collision" INSIDE the Solver SOP
//
//         WIRING ORDER:
//         prev_frame -> solver_step -> bbox_collision -> signal_brake -> Output
//
//         bbox_collision runs BEFORE signal_brake so it handles
//         all vehicle-to-vehicle spacing first.  signal_brake
//         then adds traffic light stops on top.
//
//         INPUT 0: vehicle points (from solver_step output)
//         INPUT 1: route curves  (Object Merge -> route_curves null)
//
// RUN OVER: Points
//
// v2.8: Moved BEFORE signal_brake.  This is the sole handler for
//       all vehicle-to-vehicle interactions:
//
//       1. SAME-LANE FOLLOWING — bounding-box-based spacing so
//          vehicles of different sizes never overlap
//       2. LEFT-TURN YIELD    — straight yields to oncoming left-turner
//       3. CROSS-LANE         — intersection cross-traffic awareness
//       4. EMERGENCY          — hard stop on actual penetration
//       5. POSITION CORRECTION — pulls vehicle back along route
//
//       signal_stop / signal_state are read from the PREVIOUS frame
//       (carried by prev_frame through solver_step).  Since traffic
//       lights change over seconds, one-frame-old data is accurate.
//
//       For future multi-vehicle support: replace the global
//       bbox_half_length / bbox_half_width parameters with per-point
//       attributes (f@bbox_hl, f@bbox_hw) set during init_vehicles.
//       The OBB logic already supports per-vehicle half-extents —
//       just read from attributes instead of ch().
//
// PARAMETERS (spare parms on this wrangle):
//   bbox_half_length      (float) = 2.0
//   bbox_half_width       (float) = 1.0
//   bbox_padding          (float) = 1.0
//   search_radius         (float) = 35.0
//   max_neighbors         (int)   = 50
//   brake_force           (float) = 25.0
//   look_ahead_time       (float) = 2.0
//   emergency_gap         (float) = 0.5
//   stopped_speed_thresh  (float) = 0.5
//   left_turn_yield_dist  (float) = 25.0
//   follow_gap            (float) = 6.0    *** NEW ***
//   vehicle_offset        (float) = 0.5
//   intersection_radius   (float) = 25.0
//   grid_size             (float) = 348
//   grid_divisions        (int)   = 4
// ============================================================

// ---------- parameters ----------
float half_len   = ch("bbox_half_length");      // 2.0
float half_wid   = ch("bbox_half_width");       // 1.0
float pad        = ch("bbox_padding");          // 1.0
float srch_rad   = ch("search_radius");         // 35.0
int   max_nb     = chi("max_neighbors");        // 50
float brk_force  = ch("brake_force");           // 25.0
float look_time  = ch("look_ahead_time");       // 2.0
float emer_gap   = ch("emergency_gap");         // 0.5
float stop_thresh = ch("stopped_speed_thresh"); // 0.5
float yield_dist = ch("left_turn_yield_dist");  // 25.0
float follow_gap = ch("follow_gap");            // 6.0
float y_off      = ch("vehicle_offset");        // 0.5
float isect_rad  = ch("intersection_radius");   // 25.0
float grid_size  = ch("grid_size");             // 348
int   grid_div   = chi("grid_divisions");       // 4

float dt = @TimeInc;
if (dt < 1e-6) return;

// save speed before collision logic (for position correction)
float speed_before = f@speed;

// ---------- local axes (ground plane) ----------
vector fwd = normalize(set(@N.x, 0, @N.z));
if (length(fwd) < 0.01) return;
vector rgt = set(-fwd.z, 0, fwd.x);

vector my_vel = fwd * f@speed;

// padded half-extents
float hl = half_len + pad;
float hw = half_wid + pad;

// ---------- intersection proximity (grid snap) ----------
float cell      = grid_size / float(max(1, grid_div));
float half_grid = grid_size / 2.0;
float near_ix   = rint((@P.x + half_grid) / cell) * cell - half_grid;
float near_iz   = rint((@P.z + half_grid) / cell) * cell - half_grid;
int   near_isect = (length(set(@P.x - near_ix, 0, @P.z - near_iz))
                    < isect_rad) ? 1 : 0;

// ---------- my segment type from route curves (Input 1) ----------
int num_route_prims = nprimitives(1);
string my_seg_type = "";
if (i@route_id >= 0 && i@route_id < num_route_prims)
    my_seg_type = prim(1, "segment_type", i@route_id);

int i_am_straight   = (my_seg_type == "intersection_straight") ? 1 : 0;
int i_am_left_turn  = (my_seg_type == "left_turn") ? 1 : 0;

// ============================================================
// OBB gap function (SAT, 2D)
// Returns: gap > 0 = separated,  gap <= 0 = overlapping
// Accepts per-vehicle half-extents so different-sized vehicles
// get accurate collision detection.
// ============================================================
function float obb_gap(
    vector sep;
    vector a_fwd; vector a_rgt; float a_hl; float a_hw;
    vector b_fwd; vector b_rgt; float b_hl; float b_hw)
{
    float mg = -1e9;

    float p1 = abs(dot(sep, a_fwd));
    float e1 = a_hl + abs(dot(b_fwd, a_fwd)) * b_hl
                     + abs(dot(b_rgt, a_fwd)) * b_hw;
    mg = max(mg, p1 - e1);

    float p2 = abs(dot(sep, a_rgt));
    float e2 = a_hw + abs(dot(b_fwd, a_rgt)) * b_hl
                     + abs(dot(b_rgt, a_rgt)) * b_hw;
    mg = max(mg, p2 - e2);

    float p3 = abs(dot(sep, b_fwd));
    float e3 = abs(dot(a_fwd, b_fwd)) * a_hl
             + abs(dot(a_rgt, b_fwd)) * a_hw + b_hl;
    mg = max(mg, p3 - e3);

    float p4 = abs(dot(sep, b_rgt));
    float e4 = abs(dot(a_fwd, b_rgt)) * a_hl
             + abs(dot(a_rgt, b_rgt)) * a_hw + b_hw;
    mg = max(mg, p4 - e4);

    return mg;
}

// ---------- neighbour search ----------
int neighbors[] = pcfind(0, "P", @P, srch_rad, max_nb);

float worst_urg = 0;
int   do_brake  = 0;

foreach (int nb; neighbors)
{
    if (nb == @ptnum) continue;

    string nb_curve = point(0, "curve_type", nb);
    if (nb_curve != "vehicle") continue;

    vector nb_pos   = point(0, "P",     nb);
    vector nb_N     = point(0, "N",     nb);
    float  nb_speed = point(0, "speed", nb);
    string nb_lane  = point(0, "lane_type", nb);

    // separation (2D)
    vector sep = set(nb_pos.x - @P.x, 0, nb_pos.z - @P.z);

    // ========================================================
    // NEIGHBOUR SEGMENT TYPE (from route curves, Input 1)
    // ========================================================
    int nb_route = point(0, "route_id", nb);
    string nb_seg_type = "";
    if (nb_route >= 0 && nb_route < num_route_prims)
        nb_seg_type = prim(1, "segment_type", nb_route);

    int nb_is_left_turn = (nb_seg_type == "left_turn") ? 1 : 0;
    int nb_is_straight  = (nb_seg_type == "intersection_straight") ? 1 : 0;

    // ========================================================
    // PREVIOUS-FRAME SIGNAL STATE
    //
    // bbox_collision runs BEFORE signal_brake, so the current
    // frame's signal_stop hasn't been set yet.  But the PREVIOUS
    // frame's signal_stop is still on the point (carried through
    // prev_frame -> solver_step untouched).  Traffic lights change
    // over seconds, so one-frame-old data is accurate.
    // ========================================================
    int nb_signal_stop = point(0, "signal_stop", nb);

    // ========================================================
    // LEFT-TURN YIELD RULE
    //
    // Geometric check: oncoming left-turner ahead + in
    // intersection zone.  Works for any number of vehicles.
    // ========================================================
    if (near_isect)
    {
        float nb_nix = rint((nb_pos.x + half_grid) / cell) * cell - half_grid;
        float nb_niz = rint((nb_pos.z + half_grid) / cell) * cell - half_grid;
        int same_isect = (abs(near_ix - nb_nix) < 1.0
                       && abs(near_iz - nb_niz) < 1.0) ? 1 : 0;

        if (same_isect)
        {
            // --- I'm STRAIGHT, neighbour is LEFT-TURNING -> I yield ---
            if (i_am_straight && nb_is_left_turn)
            {
                if (nb_speed < stop_thresh) { continue; }
                float dist = length(sep);
                if (dist > yield_dist) { continue; }

                float sep_f = dot(sep, fwd);
                if (sep_f <= 0) { continue; }

                float nb_to_center = length(set(nb_pos.x - near_ix,
                                                0,
                                                nb_pos.z - near_iz));
                if (nb_to_center > isect_rad) { continue; }

                float yield_urg = fit(dist, 2.0, yield_dist, 0.85, 0.2);
                yield_urg = clamp(yield_urg, 0, 1);

                if (yield_urg > worst_urg)
                {
                    worst_urg = yield_urg;
                    do_brake  = 1;
                }
                continue;
            }

            // --- I'm LEFT-TURNING, neighbour is STRAIGHT -> skip ---
            if (i_am_left_turn && nb_is_straight)
            {
                continue;
            }
        }
    }

    // ========================================================
    // DIRECTION + LANE FILTERING
    // ========================================================
    vector nb_fwd_chk = normalize(set(nb_N.x, 0, nb_N.z));
    if (length(nb_fwd_chk) < 0.01) continue;
    float dir_dot = dot(fwd, nb_fwd_chk);

    if (s@lane_type != nb_lane)
    {
        // ---- DIFFERENT lane type ----
        if (!near_isect) continue;

        // Use previous-frame signal_stop
        if (nb_signal_stop == 1) continue;
        if (nb_speed < stop_thresh) continue;

        if (abs(dir_dot) > 0.7) continue;

        float lat_dist = abs(dot(sep, rgt));
        if (lat_dist > half_wid * 2.0) continue;
    }
    else
    {
        // ---- SAME lane type ----

        // CASE A: Opposite direction
        if (dir_dot < -0.3)
        {
            if (nb_signal_stop == 1) continue;
            if (nb_speed < stop_thresh) continue;

            float lat_dist = abs(dot(sep, rgt));
            if (lat_dist > half_wid * 2.0) continue;
        }

        // CASE B: Perpendicular at intersection
        else if (near_isect && abs(dir_dot) < 0.5)
        {
            if (nb_signal_stop == 1) continue;
            if (nb_speed < stop_thresh) continue;

            float my_lat = abs(dot(sep, rgt));
            vector nb_rgt_chk = set(-nb_fwd_chk.z, 0, nb_fwd_chk.x);
            float nb_lat = abs(dot(-sep, nb_rgt_chk));
            float body_width = half_wid * 2.0;
            if (my_lat > body_width && nb_lat > body_width) continue;
        }

        // CASE C: Same direction -> full following + collision check
        //   This is the core SPACING logic: vehicles ahead on the
        //   same lane get TCA + OBB evaluation.  The bounding box
        //   half-extents define the minimum gap.  When you add
        //   different vehicle sizes, the per-vehicle half-extents
        //   will automatically produce correct spacing for each pair.
    }

    // ========================================================
    // COLLISION + SPACING DETECTION
    //
    // All vehicles reaching here are genuine interaction targets:
    //   - Same-lane following (spacing via bounding box)
    //   - Cross-traffic (during phase transitions)
    //   - Vehicles with insufficient lateral clearance
    //
    // The OBB half-extents define the physical footprint.
    // Padding adds a safety buffer.  Together they set the
    // minimum gap between any two vehicles.
    //
    // FOR FUTURE MULTI-SIZE VEHICLES:
    //   Replace the global half_len/half_wid with per-point
    //   attributes.  Read neighbour's size:
    //     float nb_hl = point(0, "bbox_hl", nb) + pad;
    //     float nb_hw = point(0, "bbox_hw", nb) + pad;
    //   The obb_gap function already takes per-vehicle extents.
    // ========================================================
    vector nb_fwd = nb_fwd_chk;
    vector nb_rgt = set(-nb_fwd.z, 0, nb_fwd.x);

    vector nb_vel = nb_fwd * nb_speed;
    float  nb_hl  = half_len + pad;    // future: point(0, "bbox_hl", nb) + pad
    float  nb_hw  = half_wid + pad;    // future: point(0, "bbox_hw", nb) + pad

    vector rel_vel = nb_vel - my_vel;

    float sep_len = length(sep);
    float closing = 0;
    if (sep_len > 0.01)
        closing = -dot(rel_vel, sep / sep_len);

    // ========================================================
    // SAME-LANE FOLLOWING GAP
    //
    // For same-direction, same-lane vehicles: maintain a minimum
    // bumper-to-bumper distance of follow_gap.
    //
    // This is separate from bbox_padding (which only affects
    // lateral clearance and OBB overlap detection).  follow_gap
    // gives you direct control over the queue spacing.
    //
    // Bumper-to-bumper = forward distance - my front - their rear
    //   = dot(sep, fwd) - half_len - nb_half_len
    //
    // For future multi-size vehicles: replace half_len with
    // per-point attributes for size-accurate following gaps.
    // ========================================================
    if (dir_dot > 0.5 && s@lane_type == nb_lane)
    {
        float sep_f = dot(sep, fwd);

        // Only check vehicles AHEAD of me
        if (sep_f > 0)
        {
            // Lateral check: must be in my lane path, not on
            // a parallel road with the same lane_type
            float lat = abs(dot(sep, rgt));
            if (lat < half_wid * 3.0)
            {
                // Bumper-to-bumper distance
                float bumper = sep_f - half_len - half_len;
                // future: sep_f - half_len - point(0, "bbox_hl", nb)

                if (bumper < follow_gap)
                {
                    // Urgency: 0 at follow_gap, ~1 at gap=0
                    float f_urg = fit(bumper, 0, follow_gap, 0.9, 0.05);
                    f_urg = clamp(f_urg, 0, 1);

                    // Hard stop if nearly touching
                    if (bumper < 0.5) f_urg = 1.0;

                    if (f_urg > worst_urg)
                    {
                        worst_urg = f_urg;
                        do_brake  = 1;
                    }
                    continue;   // handled — skip TCA/OBB for this pair
                }
            }
        }
    }

    // ---- PHASE 1: EMERGENCY (overlap + converging) ----
    if (closing > 0.1)
    {
        float gap_now = obb_gap(sep,
                                fwd, rgt, hl, hw,
                                nb_fwd, nb_rgt, nb_hl, nb_hw);

        if (gap_now < emer_gap)
        {
            float urg = fit(gap_now, -hl, emer_gap, 1.0, 0.85);
            urg = clamp(urg, 0, 1);
            if (urg > worst_urg)
            {
                worst_urg = urg;
                do_brake  = 1;
            }
            continue;
        }
    }

    // ---- PHASE 2: PREDICTIVE (TCA + future OBB) ----
    float vv = dot(rel_vel, rel_vel);
    if (vv < 0.001) continue;

    float tca = -dot(sep, rel_vel) / vv;

    if (tca <= 0) continue;
    tca = min(tca, look_time);

    vector my_fut  = set(@P.x,     0, @P.z)     + set(my_vel.x, 0, my_vel.z) * tca;
    vector nb_fut  = set(nb_pos.x, 0, nb_pos.z) + set(nb_vel.x, 0, nb_vel.z) * tca;
    vector fut_sep = nb_fut - my_fut;

    if (dot(fut_sep, fwd) < -half_len) continue;

    float gap_fut = obb_gap(fut_sep,
                            fwd, rgt, hl, hw,
                            nb_fwd, nb_rgt, nb_hl, nb_hw);

    if (gap_fut < 0)
    {
        float urg = fit(tca, 0, look_time, 0.9, 0.1);
        urg = clamp(urg, 0, 1);

        if (urg > worst_urg)
        {
            worst_urg = urg;
            do_brake  = 1;
        }
    }
}

// ============================================================
// APPLY BRAKING + POSITION CORRECTION
// ============================================================
if (do_brake)
{
    float new_speed = speed_before - brk_force * worst_urg * dt;
    f@speed = max(new_speed, 0);
    f@brake = max(f@brake, worst_urg);

    if (worst_urg > 0.95)
    {
        f@speed = 0;
        f@brake = 1.0;
    }

    i@bbox_stopped = 1;

    // ---- POSITION CORRECTION ----
    float overshoot = (speed_before - f@speed) * dt;

    if (overshoot > 0.01 && f@prim_length > 0.01)
    {
        float u_pullback = overshoot / f@prim_length;
        f@u_param = max(f@u_param - u_pullback, 0.001);

        if (i@route_id >= 0 && i@route_id < num_route_prims)
        {
            vector corrected = primuv(1, "P", i@route_id,
                                      set(f@u_param, 0, 0));
            corrected.y += y_off;
            @P = corrected;

            float tu = f@u_param;
            vector pf = primuv(1, "P", i@route_id,
                               set(min(tu + 0.04, 0.999), 0, 0));
            vector pb = primuv(1, "P", i@route_id,
                               set(max(tu - 0.04, 0.001), 0, 0));
            @N = normalize(pf - pb);
        }
    }
}
else
{
    i@bbox_stopped = 0;
}
