// ============================================================
// 08_bbox_collision.vex — Bounding Box Collision Avoidance
// ============================================================
// WHERE:  AttribWrangle "bbox_collision" INSIDE the Solver SOP
//         Wire AFTER solver_step, BEFORE signal_brake
// RUN OVER: Points
// INPUT 0: vehicle points (from solver_step output)
//
// Uses Oriented Bounding Boxes (OBB) derived from the Bound SOP
// on the car geometry to prevent vehicle-to-vehicle overlap.
// When two bounding boxes approach or overlap, the TRAILING
// vehicle decelerates proportionally to the overlap urgency.
//
// Cross-lane detection activates near intersections so vehicles
// on different lanes/routes also avoid each other when their
// paths actually cross (not when travelling in parallel).
//
// BOUNDING BOX SOURCE:
//   Connect a Bound SOP (Bounding Type = Box) to car_box2's
//   output. The Bound SOP reports the AABB of the car geometry.
//   With car_box2 set to Size(4, 1.5, 2) and Rotation(0, 90, 0):
//     Bound X-size = 2  -> half_width  = 1.0
//     Bound Y-size = 1.5 (height, not used in 2D test)
//     Bound Z-size = 4  -> half_length = 2.0
//   When Copy to Points aligns the car's +Z to the point's N,
//   Z = forward (length), X = lateral (width).
//
// If you change the car geometry, re-check the Bound SOP and
// update bbox_half_length / bbox_half_width accordingly.
//
// PARAMETERS (add as spare parms on this wrangle):
//   bbox_half_length    (float) = 2.0
//   bbox_half_width     (float) = 1.0
//   bbox_padding        (float) = 1.5
//   search_radius       (float) = 30.0
//   max_neighbors       (int)   = 50
//   brake_force         (float) = 25.0
//   intersection_radius (float) = 25.0
//   grid_size           (float) = 348
//   grid_divisions      (int)   = 4
// ============================================================

// ---------- read parameters ----------
float half_len   = ch("bbox_half_length");    // 2.0  (half Z from Bound SOP)
float half_wid   = ch("bbox_half_width");     // 1.0  (half X from Bound SOP)
float pad        = ch("bbox_padding");        // 1.5  safety margin
float search_rad = ch("search_radius");       // 30.0 pcfind radius
int   max_nb     = chi("max_neighbors");      // 50   neighbor cap
float brk_force  = ch("brake_force");         // 25.0 deceleration (units/s^2)
float isect_rad  = ch("intersection_radius"); // 25.0 cross-lane zone radius
float grid_size  = ch("grid_size");           // 348  match gen_vehicle_routes
int   grid_div   = chi("grid_divisions");     // 4    match gen_vehicle_routes

float dt = @TimeInc;
if (dt < 1e-6) return;

// ---------- vehicle local axes (ground plane) ----------
vector fwd = normalize(set(@N.x, 0, @N.z));
if (length(fwd) < 0.01) return;            // skip invalid orientation
vector rgt = set(-fwd.z, 0, fwd.x);        // perpendicular right

// padded half-extents
float hl = half_len + pad;
float hw = half_wid + pad;

// ---------- intersection proximity (fast grid snap) ----------
float cell      = grid_size / float(max(1, grid_div));
float half_grid = grid_size / 2.0;

// snap current position to nearest intersection centre
float near_ix = rint((@P.x + half_grid) / cell) * cell - half_grid;
float near_iz = rint((@P.z + half_grid) / cell) * cell - half_grid;
float dist_isect = length(set(@P.x - near_ix, 0, @P.z - near_iz));
int   near_isect = (dist_isect < isect_rad) ? 1 : 0;

// ---------- neighbour search ----------
int neighbors[] = pcfind(0, "P", @P, search_rad, max_nb);

float worst_gap = 1e9;    // smallest gap found (most urgent)
int   do_brake  = 0;

foreach (int nb; neighbors)
{
    if (nb == @ptnum) continue;

    // only check other vehicle points
    string nb_curve = point(0, "curve_type", nb);
    if (nb_curve != "vehicle") continue;

    string nb_lane = point(0, "lane_type", nb);
    vector nb_pos  = point(0, "P", nb);
    vector nb_N    = point(0, "N", nb);

    // ---- lane filtering ----
    // outside intersections: skip vehicles on a different lane
    // at intersections: skip vehicles whose path is roughly parallel
    //   (parallel = similar or opposite direction, no crossing risk)
    if (s@lane_type != nb_lane)
    {
        if (!near_isect) continue;

        // at intersection — only consider if paths actually cross
        vector nb_fwd_test = normalize(set(nb_N.x, 0, nb_N.z));
        if (length(nb_fwd_test) < 0.01) continue;
        float dir_align = abs(dot(fwd, nb_fwd_test));
        if (dir_align > 0.7) continue;   // nearly parallel -> skip
    }

    // ---- separation in our local frame ----
    vector sep = set(nb_pos.x - @P.x, 0, nb_pos.z - @P.z);
    float sep_f = dot(sep, fwd);       // + ahead, - behind
    float sep_r = dot(sep, rgt);       // + right,  - left

    // skip vehicles far behind (no collision risk from behind)
    if (sep_f < -hl * 2.0) continue;

    // ---- neighbour local axes ----
    vector nb_fwd = normalize(set(nb_N.x, 0, nb_N.z));
    if (length(nb_fwd) < 0.01) continue;
    vector nb_rgt = set(-nb_fwd.z, 0, nb_fwd.x);

    float nb_hl = half_len + pad;      // same car size assumed
    float nb_hw = half_wid + pad;

    // ====================================================
    // OBB-OBB overlap — Separating Axis Theorem (2D)
    // 4 test axes: our fwd, our rgt, their fwd, their rgt
    // gap > 0 means separated, gap <= 0 means overlapping
    // ====================================================
    float max_gap = -1e9;

    // axis 1: our forward
    {
        float p = abs(sep_f);
        float a = hl;
        float b = abs(dot(nb_fwd, fwd)) * nb_hl
                + abs(dot(nb_rgt, fwd)) * nb_hw;
        max_gap = max(max_gap, p - (a + b));
    }

    // axis 2: our right
    {
        float p = abs(sep_r);
        float a = hw;
        float b = abs(dot(nb_fwd, rgt)) * nb_hl
                + abs(dot(nb_rgt, rgt)) * nb_hw;
        max_gap = max(max_gap, p - (a + b));
    }

    // axis 3: neighbour forward
    {
        float p = abs(dot(sep, nb_fwd));
        float a = abs(dot(fwd, nb_fwd)) * hl
                + abs(dot(rgt, nb_fwd)) * hw;
        float b = nb_hl;
        max_gap = max(max_gap, p - (a + b));
    }

    // axis 4: neighbour right
    {
        float p = abs(dot(sep, nb_rgt));
        float a = abs(dot(fwd, nb_rgt)) * hl
                + abs(dot(rgt, nb_rgt)) * hw;
        float b = nb_hw;
        max_gap = max(max_gap, p - (a + b));
    }

    // ====================================================
    // collision / proximity response
    // ====================================================
    if (max_gap < pad)
    {
        // determine threat direction
        int is_threat = 0;

        // same-lane or similar direction: threat if neighbour is ahead
        if (sep_f > -half_len * 0.5) is_threat = 1;

        // intersection cross-traffic: threat if side-front proximity
        if (near_isect && abs(sep_r) < (hw + nb_hw) * 1.5)
            is_threat = 1;

        if (is_threat && max_gap < worst_gap)
        {
            worst_gap = max_gap;
            do_brake  = 1;
        }
    }
}

// ---------- apply braking ----------
if (do_brake)
{
    // urgency ramps from 0 (at pad distance) to 1 (full overlap)
    float urgency = fit(worst_gap, -hl, pad, 1.0, 0.0);
    urgency = clamp(urgency, 0, 1);

    // proportional deceleration
    float new_speed = f@speed - brk_force * urgency * dt;
    f@speed = max(new_speed, 0);

    // update brake visual (feeds color_vehicles)
    f@brake = max(f@brake, urgency);

    // hard stop on actual penetration
    if (worst_gap < 0)
    {
        f@speed = 0;
        f@brake = 1.0;
    }

    i@bbox_stopped = 1;
}
else
{
    i@bbox_stopped = 0;
}
