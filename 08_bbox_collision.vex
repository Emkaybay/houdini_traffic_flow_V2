// ============================================================
// 08_bbox_collision.vex — Predictive Bounding Box Collision
// ============================================================
// WHERE:  AttribWrangle "bbox_collision" INSIDE the Solver SOP
//         Wire AFTER solver_step, BEFORE signal_brake
// RUN OVER: Points
//
// WHAT CHANGED (v2.3 — replaces reactive v2.2):
//   The previous version checked bounding box overlap at CURRENT
//   positions only, causing vehicles on opposite lanes going in
//   opposite directions to falsely brake for each other.
//
//   This version uses PREDICTIVE collision: it computes each
//   vehicle's velocity and finds the Time-to-Closest-Approach
//   (TCA).  If TCA <= 0 the vehicles are moving APART → skip.
//   If TCA > 0, it projects both vehicles to their future
//   positions and checks if their bounding boxes will overlap
//   THERE.  Two cars passing on offset parallel lanes will be
//   predicted to clear each other → no false brake.
//
// TWO-PHASE DETECTION:
//   Phase 1 — EMERGENCY: OBBs penetrating right now AND still
//             converging → hard stop.
//   Phase 2 — PREDICTIVE: OBBs predicted to overlap within
//             look_ahead_time seconds → proportional braking
//             scaled by time-to-collision (closer = harder).
//
// BOUNDING BOX SOURCE:
//   Bound SOP (type Box) on car_box2.  With car_box2 set to
//   Size(4, 1.5, 2) Rotation(0, 90, 0):
//     Bound X = 2  → bbox_half_width  = 1.0
//     Bound Z = 4  → bbox_half_length = 2.0
//
// PARAMETERS (spare parms on this wrangle):
//   bbox_half_length      (float) = 2.0
//   bbox_half_width       (float) = 1.0
//   bbox_padding          (float) = 1.0
//   search_radius         (float) = 35.0
//   max_neighbors         (int)   = 50
//   brake_force           (float) = 25.0
//   look_ahead_time       (float) = 2.0
//   emergency_gap         (float) = 0.5
//   intersection_radius   (float) = 25.0
//   grid_size             (float) = 348
//   grid_divisions        (int)   = 4
// ============================================================

// ---------- parameters ----------
float half_len  = ch("bbox_half_length");     // 2.0
float half_wid  = ch("bbox_half_width");      // 1.0
float pad       = ch("bbox_padding");         // 1.0
float srch_rad  = ch("search_radius");        // 35.0
int   max_nb    = chi("max_neighbors");       // 50
float brk_force = ch("brake_force");          // 25.0
float look_time = ch("look_ahead_time");      // 2.0
float emer_gap  = ch("emergency_gap");        // 0.5
float isect_rad = ch("intersection_radius");  // 25.0
float grid_size = ch("grid_size");            // 348
int   grid_div  = chi("grid_divisions");      // 4

float dt = @TimeInc;
if (dt < 1e-6) return;

// ---------- local axes (ground plane) ----------
vector fwd = normalize(set(@N.x, 0, @N.z));
if (length(fwd) < 0.01) return;
vector rgt = set(-fwd.z, 0, fwd.x);

// my velocity (2D)
vector my_vel = fwd * f@speed;

// padded half-extents
float hl = half_len + pad;
float hw = half_wid + pad;

// ============================================================
// OBB-OBB gap function (Separating Axis Theorem, 2D)
// Returns the largest separating gap across 4 axes.
//   gap > 0  →  separated
//   gap <= 0 →  overlapping
// ============================================================
function float obb_gap(
    vector sep;
    vector a_fwd; vector a_rgt; float a_hl; float a_hw;
    vector b_fwd; vector b_rgt; float b_hl; float b_hw)
{
    float mg = -1e9;

    // axis 1: A forward
    float p1 = abs(dot(sep, a_fwd));
    float e1 = a_hl + abs(dot(b_fwd, a_fwd)) * b_hl
                     + abs(dot(b_rgt, a_fwd)) * b_hw;
    mg = max(mg, p1 - e1);

    // axis 2: A right
    float p2 = abs(dot(sep, a_rgt));
    float e2 = a_hw + abs(dot(b_fwd, a_rgt)) * b_hl
                     + abs(dot(b_rgt, a_rgt)) * b_hw;
    mg = max(mg, p2 - e2);

    // axis 3: B forward
    float p3 = abs(dot(sep, b_fwd));
    float e3 = abs(dot(a_fwd, b_fwd)) * a_hl
             + abs(dot(a_rgt, b_fwd)) * a_hw + b_hl;
    mg = max(mg, p3 - e3);

    // axis 4: B right
    float p4 = abs(dot(sep, b_rgt));
    float e4 = abs(dot(a_fwd, b_rgt)) * a_hl
             + abs(dot(a_rgt, b_rgt)) * a_hw + b_hw;
    mg = max(mg, p4 - e4);

    return mg;
}

// ---------- intersection proximity (grid snap) ----------
float cell      = grid_size / float(max(1, grid_div));
float half_grid = grid_size / 2.0;
float near_ix   = rint((@P.x + half_grid) / cell) * cell - half_grid;
float near_iz   = rint((@P.z + half_grid) / cell) * cell - half_grid;
int   near_isect = (length(set(@P.x - near_ix, 0, @P.z - near_iz))
                    < isect_rad) ? 1 : 0;

// ---------- neighbour search ----------
int neighbors[] = pcfind(0, "P", @P, srch_rad, max_nb);

float worst_urg = 0;        // highest urgency found
int   do_brake  = 0;

foreach (int nb; neighbors)
{
    if (nb == @ptnum) continue;

    string nb_curve = point(0, "curve_type", nb);
    if (nb_curve != "vehicle") continue;

    vector nb_pos   = point(0, "P",     nb);
    vector nb_N     = point(0, "N",     nb);
    float  nb_speed = point(0, "speed", nb);
    string nb_lane  = point(0, "lane_type", nb);

    // ---- lane filtering ----
    if (s@lane_type != nb_lane)
    {
        if (!near_isect) continue;
        // at intersection: only consider crossing paths (> ~45°)
        vector nb_f_test = normalize(set(nb_N.x, 0, nb_N.z));
        if (length(nb_f_test) < 0.01) continue;
        if (abs(dot(fwd, nb_f_test)) > 0.7) continue;
    }

    // neighbour axes
    vector nb_fwd = normalize(set(nb_N.x, 0, nb_N.z));
    if (length(nb_fwd) < 0.01) continue;
    vector nb_rgt = set(-nb_fwd.z, 0, nb_fwd.x);

    // neighbour velocity & half-extents
    vector nb_vel = nb_fwd * nb_speed;
    float  nb_hl  = half_len + pad;
    float  nb_hw  = half_wid + pad;

    // current separation (2D)
    vector sep = set(nb_pos.x - @P.x, 0, nb_pos.z - @P.z);

    // relative velocity (how neighbour moves relative to me)
    vector rel_vel = nb_vel - my_vel;

    // closing speed along the separation line
    float sep_len = length(sep);
    float closing = 0;
    if (sep_len > 0.01)
        closing = -dot(rel_vel, sep / sep_len);
    // closing > 0 → vehicles getting closer
    // closing <= 0 → vehicles moving apart or parallel

    // ====================================================
    // PHASE 1 — EMERGENCY (current-frame overlap check)
    // Only triggers if vehicles are BOTH overlapping AND
    // still converging.  Two cars that are overlapping but
    // moving apart are resolving naturally — leave them.
    // ====================================================
    if (closing > 0.1)
    {
        float gap_now = obb_gap(sep,
                                fwd, rgt, hl, hw,
                                nb_fwd, nb_rgt, nb_hl, nb_hw);

        if (gap_now < emer_gap)
        {
            float urg = fit(gap_now, -hl, emer_gap, 1.0, 0.85);
            urg = clamp(urg, 0, 1);
            if (urg > worst_urg)
            {
                worst_urg = urg;
                do_brake  = 1;
            }
            continue;   // already handled, skip predictive
        }
    }

    // ====================================================
    // PHASE 2 — PREDICTIVE (future overlap check)
    //
    // Step A: Time to Closest Approach (TCA)
    //   TCA = -dot(sep, rel_vel) / dot(rel_vel, rel_vel)
    //   If TCA <= 0 → vehicles diverging → no threat.
    //
    // Step B: Project both vehicles to future positions.
    //
    // Step C: OBB overlap test at predicted positions.
    //   If predicted overlap → brake proportionally to
    //   how soon the collision would happen.
    // ====================================================
    float vv = dot(rel_vel, rel_vel);
    if (vv < 0.001) continue;      // near-identical velocity → no convergence

    float tca = -dot(sep, rel_vel) / vv;

    if (tca <= 0) continue;         // diverging → safe
    tca = min(tca, look_time);      // cap look-ahead

    // predicted future positions
    vector my_fut  = set(@P.x,     0, @P.z)     + set(my_vel.x, 0, my_vel.z) * tca;
    vector nb_fut  = set(nb_pos.x, 0, nb_pos.z) + set(nb_vel.x, 0, nb_vel.z) * tca;
    vector fut_sep = nb_fut - my_fut;

    // skip if predicted to end up behind us
    if (dot(fut_sep, fwd) < -half_len) continue;

    // OBB test at predicted positions
    // (uses current orientations — accurate for straight travel,
    //  good approximation for gentle curves over 1–2 seconds)
    float gap_fut = obb_gap(fut_sep,
                            fwd, rgt, hl, hw,
                            nb_fwd, nb_rgt, nb_hl, nb_hw);

    if (gap_fut < 0)
    {
        // predicted overlap — urgency scales with how soon
        // tca near 0 → imminent → high urgency
        // tca near look_time → distant → low urgency
        float urg = fit(tca, 0, look_time, 0.9, 0.1);
        urg = clamp(urg, 0, 1);

        if (urg > worst_urg)
        {
            worst_urg = urg;
            do_brake  = 1;
        }
    }
}

// ---------- apply braking ----------
if (do_brake)
{
    float new_speed = f@speed - brk_force * worst_urg * dt;
    f@speed = max(new_speed, 0);
    f@brake = max(f@brake, worst_urg);

    // hard stop on extreme urgency (actual penetration)
    if (worst_urg > 0.95)
    {
        f@speed = 0;
        f@brake = 1.0;
    }

    i@bbox_stopped = 1;
}
else
{
    i@bbox_stopped = 0;
}
