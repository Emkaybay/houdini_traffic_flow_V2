// ============================================================
// 07_signal_brake.vex — Solver-Integrated Traffic Light Braking
// ============================================================
// WHERE:  AttribWrangle "signal_brake" INSIDE the Solver SOP,
//         wired AFTER solver_step.
// RUN OVER: Points
//
// Each frame, every vehicle:
//  1.  Finds the next intersection ahead along its travel axis.
//  2.  Reads the traffic-signal phase (same formula as 05).
//  3.  Decides whether it must stop.
//  4.  Applies smooth deceleration or a hard stop at the line.
//
// Signal logic per phase:
//   GREEN        — all lanes proceed
//   LEFT ARROW   — inner lane proceeds, outer lane stops
//   YELLOW       — stop UNLESS the vehicle is already committed
//                  (can't stop before the line at current speed)
//   RED / CLEAR  — stop
//
// New point attributes written:
//   i@signal_stop    1 if the vehicle is being held by a signal
//   s@signal_state   "green" / "left_arrow" / "yellow" / "red"
//
// Parameters (add as spare parms):
//   grid_size             (float)  = 348
//   grid_divisions        (int)    = 4
//   entry_dist            (float)  = 20
//   green_time            (float)  = 10.0
//   arrow_time            (float)  = 4.0
//   yellow_time           (float)  = 3.0
//   clearance_time        (float)  = 1.0
//   signal_detect_dist    (float)  = 45.0
//   signal_deceleration   (float)  = 25.0
//   stop_margin           (float)  = 1.5
// ============================================================

// ---------- grid parameters (must match gen_vehicle_routes) --
float grid_size  = ch("grid_size");            // 348
int   grid_div   = chi("grid_divisions");      // 4
float entry_dist = ch("entry_dist");           // 20

// ---------- signal timing (must match gen_traffic_lights) ----
float green_time  = ch("green_time");          // 10
float arrow_time  = ch("arrow_time");          // 4
float yellow_time = ch("yellow_time");         // 3
float clear_time  = ch("clearance_time");      // 1

// ---------- braking behaviour --------------------------------
float detect_dist = ch("signal_detect_dist");  // 45
float decel       = ch("signal_deceleration"); // 25
float stop_margin = ch("stop_margin");         // 1.5

// ---------- derived constants --------------------------------
float cell      = grid_size / float(grid_div);
float half_grid = grid_size / 2.0;

// ---------- vehicle state ------------------------------------
vector dir = @N;
if (length(dir) < 0.001) dir = {1, 0, 0};     // safety
dir = normalize(dir);
float speed = @speed;
float dt    = @TimeInc;

// ---- defaults (cleared every frame) ----
i@signal_stop  = 0;
s@signal_state = "none";

// =============================================================
// 1.  PRIMARY TRAVEL AXIS
// =============================================================
int   along_x    = (abs(dir.x) > abs(dir.z)) ? 1 : 0;
float travel_comp = along_x ? dir.x : dir.z;
if (abs(travel_comp) < 0.01) travel_comp = 0.01;   // avoid zero
float travel_sign = sign(travel_comp);
float travel_pos  = along_x ? @P.x : @P.z;

// =============================================================
// 2.  FIND NEXT INTERSECTION AHEAD
// =============================================================
// Intersections sit at:  -half_grid + idx * cell,  idx in [0..grid_div]
// A small epsilon prevents an exact-on-the-line vehicle from
// locking onto the intersection it has already entered.

float norm_pos = (travel_pos + half_grid) / cell;
int   next_idx;
if (travel_sign > 0)
    next_idx = int(ceil(norm_pos - 0.02));
else
    next_idx = int(floor(norm_pos + 0.02));

// Bounds check — no intersection ahead means edge of grid.
if (next_idx < 0 || next_idx > grid_div) next_idx = -1;

if (next_idx >= 0) {

    float isect_pos = float(next_idx) * cell - half_grid;
    float stop_line = isect_pos - travel_sign * entry_dist;
    float dist      = (stop_line - travel_pos) * travel_sign;

    // ==========================================================
    // 3.  SIGNAL PHASE  (identical to 05_gen_traffic_lights)
    // ==========================================================
    if (dist > 0 && dist < detect_dist) {

        int is_ns = (along_x == 0) ? 1 : 0;

        float half_cyc  = green_time + arrow_time + yellow_time + clear_time;
        float total_cyc = 2.0 * half_cyc;
        float pt        = @Time % total_cyc;
        if (pt < 0) pt += total_cyc;

        int   phase = 7;
        float durs[] = array(green_time, arrow_time, yellow_time, clear_time,
                             green_time, arrow_time, yellow_time, clear_time);
        float ac = 0;
        for (int i = 0; i < 8; i++) {
            ac += durs[i];
            if (pt < ac) { phase = i; break; }
        }

        // Write the signal state this vehicle sees
        string vis_state = "red";
        if (is_ns) {
            if      (phase == 0) vis_state = "green";
            else if (phase == 1) vis_state = "left_arrow";
            else if (phase == 2) vis_state = "yellow";
        } else {
            if      (phase == 4) vis_state = "green";
            else if (phase == 5) vis_state = "left_arrow";
            else if (phase == 6) vis_state = "yellow";
        }
        s@signal_state = vis_state;

        // ======================================================
        // 4.  MUST THIS VEHICLE STOP?
        // ======================================================
        int must_stop = 1;   // default: stop

        if (vis_state == "green") {
            // Green — everyone goes.
            must_stop = 0;

        } else if (vis_state == "left_arrow") {
            // Protected left-turn arrow:
            //   inner lane (potential left-turners) → proceed
            //   outer lane → stop
            must_stop = (s@lane_type == "inner") ? 0 : 1;

        } else if (vis_state == "yellow") {
            // Yellow — dilemma zone rule:
            //   If braking distance > remaining distance → committed, proceed.
            //   Otherwise → stop.
            float braking_dist = (speed > 0.1)
                               ? (speed * speed) / (2.0 * decel)
                               : 0;
            must_stop = (braking_dist > dist) ? 0 : 1;

        }
        // red / clearance → must_stop stays 1

        // ======================================================
        // 5.  APPLY BRAKING
        // ======================================================
        if (must_stop) {
            i@signal_stop = 1;

            float safe_dist = max(dist - stop_margin, 0.1);

            if (dist < stop_margin) {
                // ---- AT the stop line → hard stop ----
                @speed        = 0;
                @target_speed = 0;
                @brake        = 1.0;

            } else if (speed > 0.01) {
                // ---- Smooth deceleration:  a = v^2 / (2 d) ----
                float a_needed  = (speed * speed) / (2.0 * safe_dist);

                // Only intervene once the needed decel is non-trivial
                // (≥ 25 % of max deceleration).  This prevents light
                // tapping from 40+ metres away.
                if (a_needed >= decel * 0.25) {
                    @target_speed = 0;
                    float brake_frac = clamp(a_needed / decel, 0.0, 1.0);
                    @brake = max(@brake, brake_frac);
                    @speed = max(0, speed - a_needed * dt);
                }

            } else {
                // ---- Already stopped ----
                @speed        = 0;
                @target_speed = 0;
            }
        }
    }
}
