// ============================================================
// vehicle_awareness — Run Over: Points
// ============================================================
// v6f: Oncoming traffic filter + stronger braking.
//
// Uses pred_dir attribute on prediction points to distinguish:
//   - Oncoming traffic (dot < -0.5): SKIP — they pass on other lane
//   - Crossing traffic (dot ~ 0): CHECK — perpendicular at intersection
//   - Same-direction (dot > 0.5): CHECK — following or merging
//
// Braking is now stronger: brake_horizon = 20 frames, and the
// pullback accumulates properly because it matches the per-frame
// @Time advancement exactly at full brake.
//
// Spare parameters:
//   stop_distance, collision_threshold, vehicle_speed, time_window
// ============================================================

float stop_dist    = ch("stop_distance");
float coll_thresh  = ch("collision_threshold");
float v_speed      = ch("vehicle_speed");
int   time_window  = chi("time_window");

if(s@curve_type != "vehicle") return;

vector my_pos   = @P;
vector my_dir   = @N;
int    my_route = i@route_id;
int    my_vid   = i@vehicle_id;

int    pred_frames = 24;
float  fps = 24.0;
float  dt  = 1.0 / fps;

// Search from midpoint of prediction path
vector search_center = my_pos + my_dir * v_speed * 0.5;
float  search_radius = v_speed * 2.5;
int nearby[] = pcfind(0, "P", search_center, search_radius, 800);

// Collect MY prediction positions
vector my_preds[];
int    my_preds_ok[];
resize(my_preds, pred_frames + 1);
resize(my_preds_ok, pred_frames + 1);
for(int i = 0; i <= pred_frames; i++) my_preds_ok[i] = 0;

// Collect OTHER vehicles' predictions
int    o_frame[];
vector o_pos[];
int    o_route[];
vector o_dir[];

foreach(int nb; nearby) {
    string t = point(0, "curve_type", nb);
    if(t != "prediction") continue;

    int    vid   = point(0, "vehicle_id", nb);
    int    frame = point(0, "frame_offset", nb);
    vector pos   = point(0, "P", nb);
    int    route = point(0, "route_id", nb);
    vector pdir  = point(0, "pred_dir", nb);

    if(vid == my_vid) {
        if(frame >= 0 && frame <= pred_frames) {
            my_preds[frame] = pos;
            my_preds_ok[frame] = 1;
        }
    } else {
        append(o_frame, frame);
        append(o_pos, pos);
        append(o_route, route);
        append(o_dir, pdir);
    }
}

// --- Find earliest predicted collision ---
float earliest_ttc = float(pred_frames + 1);
vector coll_point  = my_pos;

int num_others = len(o_frame);
for(int i = 0; i < num_others; i++) {
    int g = o_frame[i];

    // ONCOMING FILTER: skip vehicles heading opposite direction
    // dot < -0.5 = oncoming on parallel lane (no collision risk)
    // dot ~ 0    = perpendicular crossing (collision risk!)
    // dot > 0.5  = same direction (following/merging)
    float dir_dot = dot(my_dir, o_dir[i]);
    if(dir_dot < -0.5) continue;

    // Must be ahead of my current position
    vector to_coll = o_pos[i] - my_pos;
    if(length(to_coll) > 0.1) {
        if(dot(normalize(to_coll), my_dir) < 0.0) continue;
    }

    // Priority: deterministic per route-pair
    int nb_route = o_route[i];
    if(nb_route != my_route) {
        int xor_val = my_route ^ nb_route;
        int higher_yields = xor_val & 1;
        int i_yield = higher_yields ? (my_route > nb_route) : (my_route < nb_route);
        if(!i_yield) continue;
    }

    // TIME-WINDOW: check my predictions within ±time_window of frame g
    int f_min = max(g - time_window, 0);
    int f_max = min(g + time_window, pred_frames);

    for(int f = f_min; f <= f_max; f++) {
        if(!my_preds_ok[f]) continue;

        float dist = length(o_pos[i] - my_preds[f]);
        if(dist >= coll_thresh) continue;

        float ttc = float(max(f, g));
        if(ttc < earliest_ttc) {
            earliest_ttc = ttc;
            coll_point = o_pos[i];
        }
    }
}

// --- Decelerate based on distance-to-collision ---
float brake = 0.0;

if(earliest_ttc <= float(pred_frames)) {
    float dist_along = dot(coll_point - my_pos, my_dir);
    dist_along = max(dist_along, 0.0);
    float room = max(dist_along - stop_dist, 0.0);
    float frame_travel = v_speed * dt;
    float frames_room  = room / max(frame_travel, 0.001);

    // Brake ramp: 20 frames of gradual braking
    float brake_horizon = 20.0;
    if(frames_room < brake_horizon) {
        brake = 1.0 - frames_room / brake_horizon;
        brake = clamp(brake, 0.0, 1.0);
        brake = smooth(0, 1, brake);
    }

    if(brake > 0.01) {
        // Pullback cancels a portion of this frame's advancement
        // At brake=1.0: pullback = frame_travel → vehicle stopped
        float pullback = brake * frame_travel;
        @P -= @N * pullback;
    }
}

// Store brake for color + prediction line truncation
f@brake = brake;
