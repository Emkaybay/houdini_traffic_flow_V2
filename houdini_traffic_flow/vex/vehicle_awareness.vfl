// ============================================================
// vehicle_awareness — Run Over: Points
// ============================================================
// v6b: Realistic deceleration — no more bouncing/oscillation.
//
// Instead of pushing vehicles backward (which caused frame-to-frame
// oscillation), this version uses SAFE POSITION TARGETING:
//   - Detects the closest vehicle ahead (tight ~30-degree cone)
//   - Computes where this vehicle SHOULD stop (safe_dist behind blocker)
//   - Smoothly interpolates toward that safe position using Hermite easing
//   - Caps maximum displacement per frame to prevent jumps
//
// Priority system prevents mutual yielding at intersections:
//   - For each pair of routes, a deterministic hash decides who yields
//   - Exactly one vehicle in each encounter slows down (no oscillation)
//
// Spare parameters:
//   awareness_radius  (Float, default 20.0) — search radius (m)
//   stop_distance     (Float, default 8.0)  — safe gap behind blocker (m)
//   slow_distance     (Float, default 18.0) — start decelerating here (m)
// ============================================================

float aware_radius = ch("awareness_radius");
float stop_dist    = ch("stop_distance");
float slow_dist    = ch("slow_distance");

if(s@curve_type != "vehicle") return;

vector my_pos   = @P;
vector my_dir   = @N;
int    my_route = i@route_id;

// Spatial query: find nearby vehicle points
int nearby[] = pcfind(0, "P", my_pos, aware_radius, 20);

float  closest_dist = aware_radius;
vector closest_pos  = my_pos;
int    found        = 0;

foreach(int nb; nearby) {
    if(nb == @ptnum) continue;

    string nb_type = point(0, "curve_type", nb);
    if(nb_type != "vehicle") continue;

    vector nb_pos = point(0, "P", nb);
    vector to_nb  = nb_pos - my_pos;
    float  dist   = length(to_nb);
    if(dist < 0.1) continue;

    // Tight forward cone (~30 degrees from travel direction)
    // Prevents detecting perpendicular or side vehicles
    float ahead_dot = dot(normalize(to_nb), my_dir);
    if(ahead_dot < 0.85) continue;

    int nb_route = point(0, "route_id", nb);

    // Cross-route priority: deterministic hash prevents mutual yielding
    // For each route pair, exactly ONE direction yields
    if(nb_route != my_route) {
        int xor_val = my_route ^ nb_route;
        int higher_yields = xor_val & 1;
        int i_yield = higher_yields ? (my_route > nb_route) : (my_route < nb_route);
        if(!i_yield) continue;  // I have priority — don't yield
    }

    if(dist < closest_dist) {
        closest_dist = dist;
        closest_pos  = nb_pos;
        found        = 1;
    }
}

if(found && closest_dist < slow_dist) {
    // Compute safe stopping position (stop_dist metres behind the blocker)
    vector to_blocker = normalize(closest_pos - my_pos);
    vector safe_pos   = closest_pos - to_blocker * stop_dist;

    // Smooth blend: 0 at slow_dist (free driving), 1 at stop_dist (full stop)
    float t = 1.0 - fit(closest_dist, stop_dist, slow_dist, 0.0, 1.0);
    t = clamp(t, 0.0, 1.0);
    t = smooth(0, 1, t);  // Hermite smoothstep — natural deceleration curve

    // Cap displacement to prevent jumps (max 4m per evaluation)
    vector disp    = safe_pos - my_pos;
    float  dlen    = length(disp);
    float  max_adj = 4.0;
    if(dlen > max_adj) {
        disp = normalize(disp) * max_adj;
        safe_pos = my_pos + disp;
    }

    // Interpolate: free position → safe position
    @P = lerp(my_pos, safe_pos, t);
}
