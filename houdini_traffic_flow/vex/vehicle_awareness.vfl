// ============================================================
// vehicle_awareness — Run Over: Points
// ============================================================
// v6c: Prediction-based collision avoidance.
//
// For each vehicle, collects its own prediction path and all
// nearby prediction paths from other vehicles. Compares them
// frame-by-frame to detect the earliest predicted collision.
//
// Braking uses distance-to-collision along own direction:
//   - At 18+ frames of room: free driving
//   - Smooth Hermite ramp-up as room decreases
//   - At 0 frames of room: full stop (pullback = 1 frame of travel)
//   - Vehicle holds position at stop_dist from collision point
//
// Priority system (XOR hash) prevents mutual yielding/oscillation.
//
// Spare parameters:
//   stop_distance         (Float, default 8.0)
//   collision_threshold   (Float, default 5.0)
//   vehicle_speed         (Float, default 15.0) — must match gen_vehicle_points
// ============================================================

float stop_dist    = ch("stop_distance");
float coll_thresh  = ch("collision_threshold");
float v_speed      = ch("vehicle_speed");

if(s@curve_type != "vehicle") return;

vector my_pos   = @P;
vector my_dir   = @N;
int    my_route = i@route_id;
int    my_vid   = i@vehicle_id;

int    pred_frames = 24;
float  fps = 24.0;
float  dt  = 1.0 / fps;

// --- Gather predictions via spatial query ---
float search_radius = v_speed * 1.5;
int nearby[] = pcfind(0, "P", my_pos, search_radius, 500);

// Collect MY prediction positions (indexed by frame)
vector my_preds[];
int    my_preds_ok[];
resize(my_preds, pred_frames + 1);
resize(my_preds_ok, pred_frames + 1);
for(int i = 0; i <= pred_frames; i++) my_preds_ok[i] = 0;

// Collect OTHER vehicles' predictions for comparison
int    o_frame[];
vector o_pos[];
int    o_route[];

foreach(int nb; nearby) {
    string t = point(0, "curve_type", nb);
    if(t != "prediction") continue;

    int    vid   = point(0, "vehicle_id", nb);
    int    frame = point(0, "frame_offset", nb);
    vector pos   = point(0, "P", nb);
    int    route = point(0, "route_id", nb);

    if(vid == my_vid) {
        // My own prediction
        if(frame >= 0 && frame <= pred_frames) {
            my_preds[frame] = pos;
            my_preds_ok[frame] = 1;
        }
    } else {
        append(o_frame, frame);
        append(o_pos, pos);
        append(o_route, route);
    }
}

// --- Find earliest predicted collision ---
float earliest_ttc = float(pred_frames + 1);
vector coll_point  = my_pos;

int num_others = len(o_frame);
for(int i = 0; i < num_others; i++) {
    int f = o_frame[i];
    if(f < 0 || f > pred_frames) continue;
    if(!my_preds_ok[f]) continue;

    // Distance between my predicted position and theirs at frame f
    float dist = length(o_pos[i] - my_preds[f]);
    if(dist >= coll_thresh) continue;

    // Must be ahead of current position (not behind)
    vector to_coll = o_pos[i] - my_pos;
    if(dot(normalize(to_coll), my_dir) < 0.0) continue;

    // Priority: deterministic per route-pair, prevents mutual yielding
    int nb_route = o_route[i];
    if(nb_route != my_route) {
        int xor_val = my_route ^ nb_route;
        int higher_yields = xor_val & 1;
        int i_yield = higher_yields ? (my_route > nb_route) : (my_route < nb_route);
        if(!i_yield) continue;
    }

    if(float(f) < earliest_ttc) {
        earliest_ttc = float(f);
        coll_point = o_pos[i];
    }
}

// --- Decelerate based on distance-to-collision ---
if(earliest_ttc <= float(pred_frames)) {
    // How far is the collision along my travel direction?
    float dist_along = dot(coll_point - my_pos, my_dir);
    dist_along = max(dist_along, 0.0);

    // Room to travel before we must stop
    float room = max(dist_along - stop_dist, 0.0);

    // How many frames of room at current speed
    float frame_travel = v_speed * dt;
    float frames_room  = room / max(frame_travel, 0.001);

    // Brake intensity: ramps up as room decreases
    float brake_horizon = 18.0;
    float brake = 0.0;
    if(frames_room < brake_horizon) {
        brake = 1.0 - frames_room / brake_horizon;
        brake = clamp(brake, 0.0, 1.0);
        brake = smooth(0, 1, brake);  // Hermite S-curve: natural deceleration
    }

    if(brake > 0.01) {
        // Cancel a portion of this frame's advancement
        // brake=0: free driving, brake=1: full stop (cancels exactly one frame of travel)
        float pullback = brake * frame_travel;
        @P -= @N * pullback;
    }
}
