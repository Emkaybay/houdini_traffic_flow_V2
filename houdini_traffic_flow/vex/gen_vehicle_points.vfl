// ============================================================
// gen_vehicle_points — Run Over: Primitives
// ============================================================
// Creates animated vehicle (box) positions along all driveable
// curves (road lanes + turn arcs).
//
// Uses @Time for animation — press Play in the Houdini timeline.
// Each vehicle is a standalone point with N (tangent) and up
// attributes for correct orientation with Copy To Points.
//
// Spare parameters:
//   vehicle_speed    (Float, default 15.0)  — m/s (~54 km/h)
//   vehicle_spacing  (Float, default 30.0)  — metres between vehicles
//   vehicle_offset   (Float, default 0.75)  — Y lift above road surface
// ============================================================

float speed   = ch("vehicle_speed");
float spacing = ch("vehicle_spacing");
float y_off   = ch("vehicle_offset");

// Primitive arc length
float prim_len = primintrinsic(0, "measuredperimeter", @primnum);
if(prim_len < spacing * 0.5) return;

// How many vehicles fit on this curve
int num_v = max(1, int(floor(prim_len / spacing)));

// Random phase per primitive so vehicles aren't in lockstep
float phase = random(@primnum);

for(int v = 0; v < num_v; v++) {
    // Base parametric position (evenly spaced along curve)
    float base_u = (float(v) + 0.5) / float(num_v);

    // Animate: shift position with time, wrap 0..1
    float animated_u = base_u + phase + @Time * speed / prim_len;
    animated_u = animated_u - floor(animated_u);

    // Sample world position on the curve
    vector pos = primuv(0, "P", @primnum, set(animated_u, 0, 0));
    pos.y += y_off;

    // Tangent via finite difference (for box orientation)
    float du = 0.005;
    float u_fwd = min(animated_u + du, 0.999);
    float u_bck = max(animated_u - du, 0.001);
    vector p_fwd = primuv(0, "P", @primnum, set(u_fwd, 0, 0));
    vector p_bck = primuv(0, "P", @primnum, set(u_bck, 0, 0));
    vector tang = normalize(p_fwd - p_bck);

    // Create vehicle point with orientation
    int pt = addpoint(0, pos);
    setpointattrib(0, "N", pt, tang, "set");
    setpointattrib(0, "up", pt, set(0, 1, 0), "set");
    setpointattrib(0, "curve_type", pt, "vehicle", "set");
    setpointgroup(0, "vehicles", pt, 1);
}
