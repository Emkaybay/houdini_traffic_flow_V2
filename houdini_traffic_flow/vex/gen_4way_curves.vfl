// ============================================================
// gen_4way_curves
// Run Over: Points
// Group: type_4way (set by classify_intersections via Blast)
// ============================================================
// Generates all flow arcs at 4-way crossings:
//   - 2 straight-through paths  (N<->S, E<->W)
//   - 4 turning arcs            (N->E, N->W, S->E, S->W)
//   - 0 U-turns                 (excluded)
//   - 1 directional chevron per curve at midpoint
//
// Add these as spare parameters on the wrangle node:
//   road_width   (Float, default 35)
//   turn_radius  (Float, default 30)
//   arc_segments (Int,   default 16)
//   chevron_size (Float, default 8)
// ============================================================

// === PARAMETERS ===
float road_width  = ch("road_width");       // 35: offset from center where curves start/end
float turn_radius = ch("turn_radius");      // 30: controls tightness of 90-degree turns
int arc_segments  = chi("arc_segments");     // 16: number of segments per curve
float chevron_size = ch("chevron_size");     // 8:  size of direction indicator

// Safety guard (redundant if Blast is upstream, but defensive)
if(s@intersection_type != "4way") return;

// --- Gather neighbour directions ---
int nbs[] = neighbours(0, @ptnum);
vector dirs[];
foreach(int nb; nbs) {
    vector nb_pos = point(0, "P", nb);
    append(dirs, normalize(nb_pos - @P));
}

// --- Radial sort by angle (around Y axis, XZ plane) ---
float angles[];
foreach(vector d; dirs) {
    append(angles, atan2(d.z, d.x));
}
for(int i = 0; i < len(angles); i++) {
    for(int j = i+1; j < len(angles); j++) {
        if(angles[j] < angles[i]) {
            float tmp_a = angles[i]; angles[i] = angles[j]; angles[j] = tmp_a;
            vector tmp_d = dirs[i];  dirs[i]   = dirs[j];   dirs[j]   = tmp_d;
        }
    }
}

// --- Cubic Bezier helper ---
function vector bezier4(vector p0; vector p1; vector p2; vector p3; float t) {
    float u = 1.0 - t;
    return u*u*u*p0 + 3.0*u*u*t*p1 + 3.0*u*t*t*p2 + t*t*t*p3;
}

// --- Generate curves for every direction pair ---
int ndirs = len(dirs);

for(int i = 0; i < ndirs; i++) {
    for(int j = i+1; j < ndirs; j++) {
        vector d_in  = dirs[i];
        vector d_out = dirs[j];

        // Angle between the two directions
        float angle = degrees(acos(clamp(dot(d_in, d_out), -1, 1)));

        // Skip U-turns (angle < 60 degrees — won't occur on regular grid)
        if(angle < 60) continue;

        // Curve start / end offset from intersection centre
        vector start  = @P + d_in  * road_width;
        vector end_pt = @P + d_out * road_width;

        // Bezier handle length (controls curvature)
        float handle_len;
        if(angle > 160) {
            // Straight-through: gentle pass
            handle_len = road_width * 0.4;
        } else {
            // ~90-degree turn: use turn_radius
            handle_len = turn_radius * 0.55;
        }

        // Control points pulled toward intersection centre
        vector cp1 = start  - d_in  * handle_len;
        vector cp2 = end_pt - d_out * handle_len;

        // Build the polyline
        int prim = addprim(0, "polyline");

        for(int s = 0; s <= arc_segments; s++) {
            float t = float(s) / float(arc_segments);
            vector pos = bezier4(start, cp1, cp2, end_pt, t);
            int pt = addpoint(0, pos);

            setpointattrib(0, "flow_t", pt, t, "set");
            setpointattrib(0, "curve_type", pt,
                angle > 160 ? "straight" : "turn", "set");

            addvertex(0, prim, pt);
        }

        // --- Chevron at midpoint ---
        float mid_t = 0.5;
        vector mid_pos = bezier4(start, cp1, cp2, end_pt, mid_t);
        vector tangent = normalize(
            bezier4(start, cp1, cp2, end_pt, mid_t + 0.01) -
            bezier4(start, cp1, cp2, end_pt, mid_t - 0.01)
        );
        // Perpendicular in XZ plane
        vector perp = set(-tangent.z, 0, tangent.x);

        vector chev_back  = mid_pos - tangent * chevron_size;
        vector chev_left  = chev_back + perp * chevron_size * 0.4;
        vector chev_right = chev_back - perp * chevron_size * 0.4;

        int chev_prim = addprim(0, "polyline");
        int p0 = addpoint(0, chev_left);
        int p1 = addpoint(0, mid_pos);
        int p2 = addpoint(0, chev_right);
        addvertex(0, chev_prim, p0);
        addvertex(0, chev_prim, p1);
        addvertex(0, chev_prim, p2);

        setprimattrib(0, "is_chevron", chev_prim, 1, "set");
    }
}
