// ============================================================
// debug_viz_circles.vex — Circle Debug Visualization
// ============================================================
// WHERE:  AttribWrangle "debug_viz" OUTSIDE the Solver
//         On a SEPARATE branch — do NOT feed into copy_cars
//
// RUN OVER: Detail
//
// INPUT 0: traffic_solver output (vehicle points with debug attribs)
//
// Creates XZ-plane circles around vehicles showing:
//   - Outer ring: detection distance (yield_dist / straight_yield_dist)
//   - Inner ring: path corridor (where yielding actually triggers)
//   - Line to threat vehicle (if detected)
//   - All colored by state
//
// WIRING:
//
//   traffic_solver
//       |
//       ├──→ color_vehicles → copy_cars → (your display)
//       |
//       └──→ debug_viz (this wrangle) → merge with display
//
// PARAMETERS (add as spare parms):
//   debug_left_yield    (int)   = 0    — same as on bbox_collision
//   debug_straight      (int)   = 0    — same as on bbox_collision
//   ring_segments       (int)   = 48   — circle smoothness
//   ring_y_offset       (float) = 0.1  — slight Y lift to avoid z-fight
// ============================================================

int   show_left  = chi("debug_left_yield");
int   show_str   = chi("debug_straight");
int   segments   = chi("ring_segments");
float y_off      = ch("ring_y_offset");

if (segments < 8) segments = 48;
if (y_off == 0) y_off = 0.1;

int num_pts = npoints(0);

for (int i = 0; i < num_pts; i++)
{
    string ctype = point(0, "curve_type", i);
    if (ctype != "vehicle") continue;

    vector vpos = point(0, "P", i);
    vpos.y += y_off;

    // ========================================================
    // LEFT TURN YIELD DEBUG
    // ========================================================
    if (show_left)
    {
        float ring_rad     = point(0, "debug_left_ring", i);
        float threat_dist  = point(0, "debug_left_threat_dist", i);
        int   yielding     = point(0, "debug_left_active", i);
        vector threat_pos  = point(0, "debug_left_target", i);

        if (ring_rad > 0)
        {
            // ---------- determine color ----------
            // Green  = no threat nearby
            // Yellow = threat in range, not yielding (filtered out)
            // Red    = actively yielding
            vector ring_col = set(0, 0.8, 0);   // green
            if (threat_dist > 0.01 && yielding == 0)
                ring_col = set(1, 1, 0);          // yellow
            if (yielding == 1)
                ring_col = set(1, 0, 0);          // red

            // ---------- outer ring: yield_dist ----------
            int ring_pts[];
            resize(ring_pts, 0);
            for (int s = 0; s <= segments; s++)
            {
                float angle = 2.0 * $PI * float(s) / float(segments);
                vector rpos = vpos + set(cos(angle) * ring_rad, 0, sin(angle) * ring_rad);
                int pt = addpoint(0, rpos);
                setpointattrib(0, "Cd", pt, ring_col, "set");
                setpointattrib(0, "curve_type", pt, "debug", "set");
                append(ring_pts, pt);
            }
            int prim = addprim(0, "polyline");
            setprimattrib(0, "curve_type", prim, "debug", "set");
            foreach (int rpt; ring_pts)
            {
                addvertex(0, prim, rpt);
            }

            // ---------- inner ring: path corridor (half_wid * 3.5) ----------
            // This shows the actual corridor where yielding triggers.
            // Smaller circle inside the detection ring.
            float inner_rad = 3.5;   // matches half_wid * 3.5 in bbox_collision
            vector inner_col = ring_col * 0.5;  // darker version of same color

            int inner_pts[];
            resize(inner_pts, 0);
            for (int s = 0; s <= segments; s++)
            {
                float angle = 2.0 * $PI * float(s) / float(segments);
                vector rpos = vpos + set(cos(angle) * inner_rad, 0, sin(angle) * inner_rad);
                int pt = addpoint(0, rpos);
                setpointattrib(0, "Cd", pt, inner_col, "set");
                setpointattrib(0, "curve_type", pt, "debug", "set");
                append(inner_pts, pt);
            }
            int iprim = addprim(0, "polyline");
            setprimattrib(0, "curve_type", iprim, "debug", "set");
            foreach (int ipt; inner_pts)
            {
                addvertex(0, iprim, ipt);
            }

            // ---------- line to threat ----------
            if (threat_dist > 0.01)
            {
                vector tpos = threat_pos;
                tpos.y += y_off;

                int lpt0 = addpoint(0, vpos);
                int lpt1 = addpoint(0, tpos);
                setpointattrib(0, "Cd", lpt0, ring_col, "set");
                setpointattrib(0, "Cd", lpt1, ring_col, "set");
                setpointattrib(0, "curve_type", lpt0, "debug", "set");
                setpointattrib(0, "curve_type", lpt1, "debug", "set");

                int lprim = addprim(0, "polyline");
                setprimattrib(0, "curve_type", lprim, "debug", "set");
                addvertex(0, lprim, lpt0);
                addvertex(0, lprim, lpt1);
            }
        }
    }

    // ========================================================
    // STRAIGHT VS STRAIGHT DEBUG
    // ========================================================
    if (show_str)
    {
        float ring_rad     = point(0, "debug_straight_ring", i);
        float threat_dist  = point(0, "debug_straight_threat_dist", i);
        int   braking      = point(0, "debug_straight_active", i);
        vector threat_pos  = point(0, "debug_straight_target", i);

        if (ring_rad > 0)
        {
            // ---------- determine color ----------
            // Cyan    = no threat nearby
            // Orange  = threat in range, not braking (filtered out)
            // Magenta = actively braking
            vector ring_col = set(0, 0.8, 0.8);  // cyan
            if (threat_dist > 0.01 && braking == 0)
                ring_col = set(1, 0.5, 0);        // orange
            if (braking == 1)
                ring_col = set(1, 0, 1);           // magenta

            // ---------- outer ring: straight_yield_dist ----------
            int ring_pts[];
            resize(ring_pts, 0);
            for (int s = 0; s <= segments; s++)
            {
                float angle = 2.0 * $PI * float(s) / float(segments);
                vector rpos = vpos + set(cos(angle) * ring_rad, 0, sin(angle) * ring_rad);
                int pt = addpoint(0, rpos);
                setpointattrib(0, "Cd", pt, ring_col, "set");
                setpointattrib(0, "curve_type", pt, "debug", "set");
                append(ring_pts, pt);
            }
            int prim = addprim(0, "polyline");
            setprimattrib(0, "curve_type", prim, "debug", "set");
            foreach (int rpt; ring_pts)
            {
                addvertex(0, prim, rpt);
            }

            // ---------- inner ring: lateral clearance (half_wid * 2.5) ----------
            float inner_rad = 2.5;   // matches clear_thresh in bbox_collision
            vector inner_col = ring_col * 0.5;

            int inner_pts[];
            resize(inner_pts, 0);
            for (int s = 0; s <= segments; s++)
            {
                float angle = 2.0 * $PI * float(s) / float(segments);
                vector rpos = vpos + set(cos(angle) * inner_rad, 0, sin(angle) * inner_rad);
                int pt = addpoint(0, rpos);
                setpointattrib(0, "Cd", pt, inner_col, "set");
                setpointattrib(0, "curve_type", pt, "debug", "set");
                append(inner_pts, pt);
            }
            int iprim = addprim(0, "polyline");
            setprimattrib(0, "curve_type", iprim, "debug", "set");
            foreach (int ipt; inner_pts)
            {
                addvertex(0, iprim, ipt);
            }

            // ---------- line to threat ----------
            if (threat_dist > 0.01)
            {
                vector tpos = threat_pos;
                tpos.y += y_off;

                int lpt0 = addpoint(0, vpos);
                int lpt1 = addpoint(0, tpos);
                setpointattrib(0, "Cd", lpt0, ring_col, "set");
                setpointattrib(0, "Cd", lpt1, ring_col, "set");
                setpointattrib(0, "curve_type", lpt0, "debug", "set");
                setpointattrib(0, "curve_type", lpt1, "debug", "set");

                int lprim = addprim(0, "polyline");
                setprimattrib(0, "curve_type", lprim, "debug", "set");
                addvertex(0, lprim, lpt0);
                addvertex(0, lprim, lpt1);
            }
        }
    }
}
