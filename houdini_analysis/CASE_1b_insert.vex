// ============================================================
// CASE 1b — INSERT INSTRUCTIONS
//
// In your existing bbox_collision code, find CASE 1's closing:
//
//        continue;
//    }
//
//    // ---------- CASE 2: I'm turning, they're straight ----------
//
// INSERT everything between the ===== markers below, right
// between CASE 1's `continue;` + closing brace and the
// CASE 2 comment.
//
// NO new parameters needed — same spare parms as v2.8.
// ============================================================


                    // ======================================================
                    // CASE 1b: Both intersection_straight, conflicting
                    // (NEW v2.9 — fixes false braking)
                    //
                    // Previously these pairs had no CASE and fell through
                    // to the OBB safety net, which uses PADDED dimensions.
                    // Two perpendicular padded boxes (6x4 each) overlap at
                    // ~7 units separation, causing false hard-stops on
                    // vehicles that would safely pass.
                    //
                    // Fix: handle all straight-vs-straight here with a
                    // `continue` at the end so the padded safety net is
                    // never reached for these pairs.
                    //
                    //   Opposing:     always skip (parallel offset lanes)
                    //   Perp + clear: skip (non-crossing paths)
                    //   Perp + cross: TCA with UNPADDED OBB only
                    // ======================================================
                    if (i_am_straight && nb_is_straight)
                    {
                        // Compute neighbour's actual heading (ground plane)
                        vector nb_fwd_2d = normalize(set(nb_N.x, 0, nb_N.z));
                        float heading_dot = dot(fwd, nb_fwd_2d);

                        // --- OPPOSING DIRECTION (heading_dot < -0.3) ---
                        // Same road, parallel offset lanes.
                        // Lane spacing (>= 3.5) > body width (2.0).
                        // Always safe to pass side by side.
                        if (heading_dot < -0.3)
                        {
                            continue;
                        }

                        // --- PERPENDICULAR OR ANGLED ---
                        // Check lateral clearance using UNPADDED body width.
                        // If both vehicles are far enough to the side of
                        // each other's path, their routes don't cross.
                        float lat_clear = abs(dot(sep, rgt));
                        vector nb_rgt_2d = set(-nb_fwd_2d.z, 0, nb_fwd_2d.x);
                        float nb_lat_clear = abs(dot(-sep, nb_rgt_2d));

                        // Threshold: 2.5x half_wid gives margin above
                        // actual body width without the heavy padding.
                        // half_wid=1.0 -> threshold=2.5 per vehicle.
                        float clear_thresh = half_wid * 2.5;

                        if (lat_clear > clear_thresh && nb_lat_clear > clear_thresh)
                        {
                            // Non-crossing paths (e.g. outer-outer perpendicular,
                            // or inner-outer mixed). Safe to pass.
                            continue;
                        }

                        // --- CROSSING PATHS (inner-inner perpendicular) ---
                        // Paths may genuinely cross. Use TCA prediction with
                        // UNPADDED OBB to check if they'd actually overlap
                        // at the moment they meet.
                        //
                        // Key difference from the general Phase 2 below:
                        //   - Uses UNPADDED half-extents (actual car size)
                        //   - This prevents the inflated padding from
                        //     triggering false overlap predictions
                        //   - The `continue` at the end ensures the padded
                        //     safety net + emergency checks are skipped
                        {
                            vector nb_vel_2d = nb_fwd_2d * nb_speed;
                            vector rel_v = nb_vel_2d - my_vel;
                            float vv = dot(rel_v, rel_v);

                            if (vv > 0.001)
                            {
                                float tca = -dot(sep, rel_v) / vv;

                                // tca <= 0: vehicles diverging -> safe
                                if (tca > 0 && tca < look_time)
                                {
                                    // Project both to predicted positions at TCA
                                    vector my_fut  = set(@P.x, 0, @P.z) + my_vel * tca;
                                    vector nb_fut  = set(nb_pos.x, 0, nb_pos.z) + nb_vel_2d * tca;
                                    vector fut_sep = nb_fut - my_fut;

                                    // UNPADDED OBB overlap test at predicted positions
                                    float gap = obb_gap(fut_sep,
                                        fwd, rgt, half_len, half_wid,
                                        nb_fwd_2d, nb_rgt_2d, half_len, half_wid);

                                    if (gap < 0)
                                    {
                                        // Genuine collision predicted at TCA.
                                        // Brake proportionally: imminent = harder.
                                        float urg = fit(tca, 0, look_time, 0.85, 0.15);
                                        urg = clamp(urg, 0, 1);
                                        if (urg > worst_urg)
                                        {
                                            worst_urg = urg;
                                            do_brake  = 1;
                                        }
                                    }
                                    // gap >= 0: they miss each other -> safe
                                }
                            }
                            // vv near 0: both nearly stationary -> no risk
                        }

                        // Always continue here — skip the padded safety net,
                        // emergency, and general predictive checks for this
                        // pair.  The unpadded TCA above is the sole arbiter
                        // for crossing straight vehicles.
                        continue;
                    }
