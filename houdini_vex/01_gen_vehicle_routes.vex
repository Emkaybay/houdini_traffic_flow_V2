// ============================================================
// STEP 1: gen_vehicle_routes.vex — INTERSECTION SEGMENTS
// ============================================================
// WHERE: AttribWrangle "gen_vehicle_routes", Run Over: Detail
//
// Creates SHORT segments between intersections instead of
// edge-to-edge routes. Each segment has lane_type attribute.
//
// Segment types:
//   "road"                  — between two intersections
//   "intersection_straight" — straight through an intersection
//   "right_turn"            — outer lane right turn arc
//   "left_turn"             — inner lane left turn arc
//
// Lane rules (enforced in solver):
//   outer lane → road(outer), straight(outer), right_turn
//   inner lane → road(inner), straight(inner), left_turn
//
// Parameters:
//   grid_size      (float) = 348
//   grid_divisions (int)   = 4
//   lane_spacing   (float) = 3.5
//   entry_dist     (float) = 20
//   arc_segments   (int)   = 32
// ============================================================

float grid_size  = ch("grid_size");
int   grid_div   = chi("grid_divisions");
float lane_space = ch("lane_spacing");
float entry_dist = ch("entry_dist");
int   arc_segs   = chi("arc_segments");

float cell = grid_size / float(grid_div);
float half = grid_size / 2.0;
int   num_isects = grid_div + 1;
float inner_off = lane_space * 0.5;
float outer_off = lane_space * 1.5;

function vector bezier4(vector p0; vector p1; vector p2; vector p3; float t) {
    float u = 1.0 - t;
    return u*u*u*p0 + 3.0*u*u*t*p1 + 3.0*u*t*t*p2 + t*t*t*p3;
}

vector travels[] = array(set(1,0,0), set(-1,0,0), set(0,0,1), set(0,0,-1));

for(int di = 0; di < 4; di++) {
    vector travel = travels[di];
    vector right_d = set(-travel.z, 0, travel.x);
    vector left_d  = -right_d;
    vector d = -travel;
    int along_x = (abs(travel.x) > 0.5);

    // Loop over perpendicular roads
    for(int road = 0; road < num_isects; road++) {
        float road_perp = -half + road * cell;

        // Loop over lanes (0=inner, 1=outer)
        for(int lane = 0; lane < 2; lane++) {
            float off = (lane == 0) ? inner_off : outer_off;
            string ltype = (lane == 0) ? "inner" : "outer";
            vector loff = right_d * off;

            for(int isect = 0; isect < num_isects; isect++) {
                float isect_pos = -half + isect * cell;
                vector ic = along_x ? set(isect_pos, 0, road_perp)
                                     : set(road_perp, 0, isect_pos);

                // =============================================
                // STRAIGHT-THROUGH at this intersection
                // =============================================
                vector st_s = ic - travel * entry_dist + loff;
                vector st_e = ic + travel * entry_dist + loff;

                // Clip to grid bounds
                st_s.x = clamp(st_s.x, -half, half);
                st_s.z = clamp(st_s.z, -half, half);
                st_e.x = clamp(st_e.x, -half, half);
                st_e.z = clamp(st_e.z, -half, half);

                if(length(st_e - st_s) > 0.5) {
                    int pr = addprim(0, "polyline");
                    addvertex(0, pr, addpoint(0, st_s));
                    addvertex(0, pr, addpoint(0, st_e));
                    setprimattrib(0, "lane_type", pr, ltype, "set");
                    setprimattrib(0, "segment_type", pr, "intersection_straight", "set");
                }

                // =============================================
                // ROAD SEGMENT to next intersection IN TRAVEL DIRECTION
                // =============================================
                float travel_sign = along_x ? travel.x : travel.z;
                int next_idx = isect + ((travel_sign > 0) ? 1 : -1);
                if(next_idx >= 0 && next_idx < num_isects) {
                    float next_pos = -half + next_idx * cell;
                    vector nc = along_x ? set(next_pos, 0, road_perp)
                                         : set(road_perp, 0, next_pos);

                    vector rd_s = ic + travel * entry_dist + loff;
                    vector rd_e = nc - travel * entry_dist + loff;

                    rd_s.x = clamp(rd_s.x, -half, half);
                    rd_s.z = clamp(rd_s.z, -half, half);
                    rd_e.x = clamp(rd_e.x, -half, half);
                    rd_e.z = clamp(rd_e.z, -half, half);

                    if(length(rd_e - rd_s) > 0.5) {
                        int pr = addprim(0, "polyline");
                        addvertex(0, pr, addpoint(0, rd_s));
                        addvertex(0, pr, addpoint(0, rd_e));
                        setprimattrib(0, "lane_type", pr, ltype, "set");
                        setprimattrib(0, "segment_type", pr, "road", "set");
                    }
                }
            }
        }
    }

    // =============================================
    // TURN ARCS for this travel direction
    // =============================================
    for(int road = 0; road < num_isects; road++) {
        float road_perp = -half + road * cell;

        for(int isect = 0; isect < num_isects; isect++) {
            float isect_pos = -half + isect * cell;
            vector ic = along_x ? set(isect_pos, 0, road_perp)
                                 : set(road_perp, 0, isect_pos);

            // --- RIGHT TURN (outer lane) ---
            {
                vector new_right = set(-right_d.z, 0, right_d.x);
                vector arc_s = ic + d * entry_dist + right_d * outer_off;
                vector arc_e = ic + right_d * entry_dist + new_right * outer_off;

                // Bounds check
                if(abs(arc_s.x) <= half + 1 && abs(arc_s.z) <= half + 1 &&
                   abs(arc_e.x) <= half + 1 && abs(arc_e.z) <= half + 1) {

                    float h = entry_dist * 0.45;
                    vector cp1 = arc_s + travel * h;
                    vector cp2 = arc_e - right_d * h;

                    int pr = addprim(0, "polyline");
                    for(int s = 0; s <= arc_segs; s++) {
                        float t = float(s) / float(arc_segs);
                        addvertex(0, pr, addpoint(0, bezier4(arc_s, cp1, cp2, arc_e, t)));
                    }
                    setprimattrib(0, "lane_type", pr, "outer", "set");
                    setprimattrib(0, "segment_type", pr, "right_turn", "set");
                }
            }

            // --- LEFT TURN (inner lane) ---
            {
                vector new_right_l = set(-left_d.z, 0, left_d.x);
                vector arc_s = ic + d * entry_dist + right_d * inner_off;
                vector arc_e = ic + left_d * entry_dist + new_right_l * inner_off;

                if(abs(arc_s.x) <= half + 1 && abs(arc_s.z) <= half + 1 &&
                   abs(arc_e.x) <= half + 1 && abs(arc_e.z) <= half + 1) {

                    float h = entry_dist * 0.72;
                    vector cp1 = arc_s + travel * h;
                    vector cp2 = arc_e - left_d * h;

                    int pr = addprim(0, "polyline");
                    for(int s = 0; s <= arc_segs; s++) {
                        float t = float(s) / float(arc_segs);
                        addvertex(0, pr, addpoint(0, bezier4(arc_s, cp1, cp2, arc_e, t)));
                    }
                    setprimattrib(0, "lane_type", pr, "inner", "set");
                    setprimattrib(0, "segment_type", pr, "left_turn", "set");
                }
            }
        }
    }
}
