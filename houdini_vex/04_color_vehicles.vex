// ============================================================
// STEP 4: color_vehicles.vex
// ============================================================
// WHERE: AttribWrangle named "color_vehicles" AFTER the Solver
// RUN OVER: Points
//
// Reads f@brake and colors vehicles:
//   Green  → cruising (brake = 0)
//   Yellow → slowing  (brake ~ 0.5)
//   Red    → stopped  (brake ~ 1.0)
// ============================================================

float b = f@brake;

if(b < 0.01) {
    @Cd = {0.15, 0.85, 0.25};
}
else if(b < 0.5) {
    float t = b / 0.5;
    @Cd = lerp({0.15, 0.85, 0.25}, {1.0, 0.85, 0.1}, t);
}
else {
    float t = (b - 0.5) / 0.5;
    @Cd = lerp({1.0, 0.85, 0.1}, {0.95, 0.12, 0.1}, t);
}
